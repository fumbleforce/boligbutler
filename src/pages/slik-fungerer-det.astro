---
import Base from '../layouts/Base.astro';
import Crumbs from '../components/Crumbs.astro';
import Icon from '../components/Icon.astro';
import Photo from '../components/Photo.astro';
import CtaBand from '../components/CtaBand.astro';
import Faq from '../components/Faq.astro';
import { included, extras, standardKit, beforeStart, beforeReturn } from '../data/site';

const steps = [
  { t: 'Du beskriver prosjektet', d: 'Hva skal gjøres, hvor stort er det, og når vil du starte? Et par setninger og gjerne et bilde av stedet holder.' },
  { t: 'Forslag og pris', d: 'BoligButler foreslår utstyr og rekkefølge, og hvilken hjelp som kan være lurt for akkurat din jobb. Du får pris før du bestemmer deg.' },
  { t: 'Befaring ved behov', d: 'For drenering, støttemur og større gravearbeid er en befaring ofte verdt det. Da ser dere på tilkomst, grunn, masser og hvor vannet skal.' },
  { t: 'Levering og innføring', d: 'Utstyret leveres dit det skal brukes, sammen med prosjektkassen. Du får en gjennomgang av betjening og sikkerhet før du starter.' },
  { t: 'Du gjør jobben', d: 'Lurer du på noe underveis, ringer du. Har dere avtalt det, kommer BoligButler på stedet i de kritiske fasene.' },
  { t: 'Henting', d: 'Når du er ferdig, hentes utstyret. Sjekklisten «Før du leverer tilbake» gjør returen rask.' },
];
const faq = [
  { q: 'Hva koster det?', a: 'Prisen avhenger av prosjektet, utstyret og hvor lenge du trenger det. Du får et konkret tilbud etter at du har beskrevet prosjektet, før du forplikter deg.' },
  { q: 'Hva om jeg bare vil leie en maskin?', a: 'Det går fint. Du får alltid levering, prosjektkasse og innføring i trygg bruk. Råd og annen hjelp får du når du ber om det.' },
  { q: 'Hva skjer hvis noe går i stykker?', a: 'Si fra med en gang. Mye kan løses på telefon, og BoligButler kommer ut hvis det trengs. Det er bedre å stoppe enn å fortsette med utstyr som ikke fungerer som det skal.' },
];
---
<Base title="Slik fungerer BoligButler" description="Fra du beskriver prosjektet til utstyret hentes igjen: forslag og pris, befaring ved behov, levering med innføring, prosjektkasse og en rådgiver du kan ringe. Holmestrand til Tønsberg-området.">
  <section class="section--tight section">
    <div class="wrap">
      <Crumbs items={[{ href: '', label: 'Slik fungerer det' }]} />
      <div class="head">
        <h1>Slik fungerer det</h1>
        <p>BoligButler selger ikke maskiner. BoligButler hjelper deg med å gjennomføre et prosjekt, og utstyret er en del av det.</p>
      </div>
      <Photo name="levering" class="lev" alt="Tilhenger lastes med pukk fra hjullaster" hint="levering av masser" ratio="560 / 345" />
      <ol class="steps">
        {steps.map((s, i) => (
          <li><span class="n" aria-hidden="true">{i + 1}</span><div><h2>{s.t}</h2><p>{s.d}</p></div></li>
        ))}
      </ol>
    </div>
  </section>

  <section class="section section--band">
    <div class="wrap">
      <div class="head">
        <h2>Du bestemmer hvor mye hjelp du vil ha</h2>
        <p>Noe følger alltid med. Resten legger du til hvis du vil, og bare det du faktisk trenger.</p>
      </div>
      <div class="offer">
        <div class="offer-col offer-col--base">
          <h3>Alltid med</h3>
          <ul>{included.map((i) => <li><Icon name="check" size={18} /> <span>{i}</span></li>)}</ul>
        </div>
        <div class="offer-col">
          <h3>Når du ønsker det</h3>
          <ul>{extras.map((e) => <li><Icon name="person" size={18} /> <span>{e.text}</span></li>)}</ul>
        </div>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap kit">
      <div>
        <h2>Prosjektkassen</h2>
        <p class="lead">Kassen følger med alle utleier. Den inneholder det erfaring viser at folk mangler midt i en jobb. Til de største prosjektene kommer en tilleggskasse tilpasset akkurat det prosjektet.</p>
        <p class="muted">Savner du noe, si fra. Kanskje blir det med i neste versjon.</p>
        <Photo name="prosjektkasse" alt="Innholdet i BoligButlers prosjektkasse" hint="prosjektkassen åpnet, med innholdet lagt utover" ratio="3 / 2" />
      </div>
      <div class="kit-list">
        {standardKit.map((g) => (
          <div><h3>{g.group}</h3><ul>{g.items.map((i) => <li>{i}</li>)}</ul></div>
        ))}
      </div>
    </div>
  </section>

  <section class="section--tight section section--band">
    <div class="wrap lists">
      <div class="sheet">
        <h2>Før du starter</h2>
        <ul>{beforeStart.map((i) => <li><span class="box" aria-hidden="true"></span>{i}</li>)}</ul>
      </div>
      <div class="sheet">
        <h2>Før du leverer tilbake</h2>
        <ul>{beforeReturn.map((i) => <li><span class="box" aria-hidden="true"></span>{i}</li>)}</ul>
      </div>
    </div>
    <p class="wrap sheet-note muted">Begge sjekklistene følger med som laminerte ark.</p>
  </section>

  <section class="section"><div class="narrow"><Faq items={faq} /></div></section>
  <CtaBand />
</Base>
<style>
  :global(.lev) { max-width: 36rem; margin-bottom: 2.5rem; }
  .steps { list-style: none; padding: 0; margin: 0; display: grid; grid-template-columns: repeat(3, 1fr); gap: 1.25rem; }
  .steps li { display: flex; gap: 1rem; padding: 1.5rem; border: 1px solid var(--line); border-radius: 12px; }
  .n { flex: none; display: grid; place-items: center; width: 2.25rem; height: 2.25rem; border-radius: 50%; background: var(--green); color: #fff; font-weight: 700; }
  .steps h2 { font-size: var(--step-1); margin: 0.35rem 0 0.4rem; }
  .steps p { color: var(--ink-2); margin: 0; font-size: 0.97rem; }
  .offer { display: grid; grid-template-columns: 1fr 1fr; gap: 1.25rem; }
  .offer-col { border: 1px solid var(--line); border-radius: 12px; padding: 1.75rem; background: #fff; }
  .offer-col--base { border: 2px solid var(--green); }
  .offer-col h3 { font-size: var(--step-2); margin-bottom: 1rem; }
  .offer-col ul { list-style: none; padding: 0; margin: 0; display: grid; gap: 0.7rem; }
  .offer-col li { display: flex; gap: 0.6rem; align-items: flex-start; line-height: 1.45; }
  .offer-col li :global(svg) { color: var(--green); flex: none; margin-top: 0.12rem; }
  .kit { display: grid; grid-template-columns: 1fr 1.1fr; gap: clamp(2rem, 1rem + 4vw, 4.5rem); align-items: start; }
  .kit :global(.photo) { margin-top: 1.5rem; }
  .kit-list { display: grid; grid-template-columns: repeat(2, 1fr); gap: 1.25rem; }
  .kit-list > div { border: 1px solid var(--line); border-radius: 12px; padding: 1.1rem 1.25rem; }
  .kit-list h3 { font-size: 1rem; margin-bottom: 0.4rem; }
  .kit-list ul { list-style: none; padding: 0; margin: 0; color: var(--ink-2); font-size: 0.95rem; display: grid; gap: 0.2rem; }
  .lists { display: grid; grid-template-columns: 1fr 1fr; gap: 1.5rem; }
  .sheet { background: #fff; border: 1px solid var(--line); border-radius: 12px; padding: 1.6rem 1.8rem; }
  .sheet h2 { font-size: var(--step-2); }
  .sheet ul { list-style: none; padding: 0; margin: 0; }
  .sheet li { display: flex; gap: 0.75rem; align-items: center; padding: 0.55rem 0; border-bottom: 1px solid var(--line); }
  .sheet li:last-child { border-bottom: 0; }
  .box { flex: none; width: 1.1rem; height: 1.1rem; border: 1.5px solid var(--green); border-radius: 4px; }
  .sheet-note { margin-top: 1.25rem; font-size: var(--step--1); }
  @media (max-width: 900px) { .steps, .offer, .kit, .lists { grid-template-columns: 1fr; } }
  @media (max-width: 480px) { .kit-list { grid-template-columns: 1fr; } }
</style>
