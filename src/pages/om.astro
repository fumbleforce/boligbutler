---
import Base from '../layouts/Base.astro';
import Crumbs from '../components/Crumbs.astro';
import Icon from '../components/Icon.astro';
import Photo from '../components/Photo.astro';
import VestfoldMap from '../components/VestfoldMap.astro';
import CtaBand from '../components/CtaBand.astro';
import { site } from '../data/site';

const principles = [
  { t: 'Kunden bestemmer', d: 'Det er ditt hus og ditt prosjekt. BoligButler bidrar med utstyr, kompetanse og støtte når du ønsker eller trenger det.' },
  { t: 'Råd når du spør, instruksjon når det trengs', d: 'BoligButler presser ikke på med råd du ikke har bedt om. Men instruksjon i trygg bruk er en plikt, fordi den hindrer skader på folk, eiendom og utstyr.' },
  { t: 'Reell verdi, ingen unødvendige kostnader', d: 'Du skal leie det prosjektet ditt trenger, ikke mer. Hvis en jobb bør gjøres av fagfolk, får du vite det.' },
  { t: 'Tenkt gjennom på forhånd', d: 'Jo mer BoligButler har forberedt, desto enklere blir prosjektet for deg. Det er derfor prosjektkassen og sjekklistene finnes.' },
];
const work = [
  { name: 'arbeid-hage', alt: 'Uteområde med murte bed, trapp og beplantning', cap: 'Bed, trapp og murer ved inngangsparti' },
  { name: 'arbeid-terrasse', alt: 'Terrasse i grå royalimpregnert tre med trapp og utsikt mot fjorden', cap: 'Terrasse med trapp og fjordutsikt' },
  { name: 'arbeid-benk', alt: 'Murt benk i tegl med treseter og ny terrasse', cap: 'Murt benk og terrassegulv' },
  { name: 'arbeid-skiferheller', alt: 'Skiferheller lagt i uregelmessig mønster', cap: 'Skiferheller' },
  { name: 'arbeid-belegningsstein', alt: 'Innkjørsel med belegningsstein og kantstein', cap: 'Belegningsstein i innkjørsel' },
  { name: 'arbeid-veranda', alt: 'Innglasset veranda med teglvegg, fliser og benk', cap: 'Innglasset veranda' },
  { name: 'arbeid-terrasse-bed', alt: 'Hevet terrasse med rekkverk og nyplantet bed foran et brunt hus', cap: 'Hevet terrasse og nytt bed' },
  { name: 'arbeid-terrassetrinn', alt: 'Terrassetrinn i impregnert tre foran en dør, med rekkverk', cap: 'Trinn og rekkverk' },
  { name: 'arbeid-pizzaovn', alt: 'Murt pizzaovn i tegl med fjordutsikt', cap: 'Murt pizzaovn ute' },
  { name: 'arbeid-fasade', alt: 'Hus med ny, mørkebrun stående kledning og nye vinduer', cap: 'Ny kledning og vinduer' },
  { name: 'arbeid-kjokken', alt: 'Kjøkken med grønne fronter og benkeplate i marmorimitasjon', cap: 'Nytt kjøkken' },
  { name: 'arbeid-fundament', alt: 'Nystøpt betongplate med forskaling og drenerende pukk langs kanten', cap: 'Fundament og støpt plate' },
];

const jsonLd = [{
  '@context': 'https://schema.org',
  '@type': 'AboutPage',
  name: 'Om BoligButler',
  url: `${site.url}/om/`,
  about: { '@id': `${site.url}/#virksomhet` },
}];
---
<Base title="Om BoligButler – lokal prosjektpartner i Vestfold" description={`${site.vision} Lokal prosjektpartner for huseiere og hytteeiere fra Holmestrand til Tønsberg-området.`} jsonLd={jsonLd}>
  <section class="section--tight section intro">
    <div class="wrap">
      <Crumbs items={[{ href: '', label: 'Om BoligButler' }]} />
      <div class="top">
        <div>
          <h1>En lokal prosjektpartner i Vestfold</h1>
          <p class="lead">Jeg har alltid likt uttrykket mestring. I et langt arbeidsliv har jeg møtt mange som søker nettopp det, gjerne i nye oppgaver utenfor det vante. Så hvorfor ikke rigge en mulighet til å bidra til noe av dette innenfor et fag jeg alltid har vært glad i?</p>
          <p>Anleggsgartnerfaget er allsidig. Er du i tillegg litt nysgjerrig, er det mye spennende du kan få til på egen hånd, men kanskje ikke helt alene.</p>
          <p>Utleiefirmaer får telefoner fra folk som for eksempel vil leie en maskin. Bakgrunnen kan være helt avklart, eller litt usikker fordi oppgaven som skal løses, er ny.</p>
          <p>Tanken bak BoligButler er å anerkjenne ønsket ditt om å mestre prosjektet selv, og ut fra det gi deg det bidraget og den bistanden du trenger for å gjennomføre det trygt.</p>
          <p>Derfor er BoligButler bygget rundt prosjekter. Utstyret er et virkemiddel. Det som gjør forskjellen, er at jobben er tenkt gjennom på forhånd, at det som trengs blir levert, og at noen er tilgjengelig når du står med et spørsmål midt i grøfta.</p>
          <p>BoligButler holder til i Horten og er primært tilgjengelig fra Holmestrand i nord til Tønsberg-området i sør og øst. Kundene er huseiere og hytteeiere som vil gjøre jobben selv, setter kvalitet og service høyere enn laveste pris, og gjerne vil ha en lokal, allsidig samarbeidspartner over tid.</p>
        </div>
        <figure class="founder">
          <Photo name="grunnlegger" alt={`${site.founder.name}, ${site.founder.role.toLowerCase()} i BoligButler`} hint="portrett av grunnleggeren" ratio="4 / 5" eager />
          <figcaption><strong>{site.founder.name}</strong><span>{site.founder.role}</span></figcaption>
        </figure>
      </div>
      <blockquote class="vision">
        <p>«{site.vision}»</p>
        <footer>Visjonen alle beslutninger i BoligButler testes mot</footer>
      </blockquote>
    </div>
  </section>

  <section class="section--tight section">
    <div class="wrap">
      <div class="head">
        <h2>Fra tidligere prosjekter</h2>
        <p>Et utvalg av jobber på hus og uteområder. Slik ser det ut når grunnarbeidet er gjort skikkelig.</p>
      </div>
      <ul class="work">
        {work.map((w) => (
          <li><figure><Photo name={w.name} alt={w.alt} hint={w.cap} ratio="4 / 3" /><figcaption>{w.cap}</figcaption></figure></li>
        ))}
      </ul>
    </div>
  </section>

  <section class="section section--band">
    <div class="wrap">
      <div class="head"><h2>Slik jobber BoligButler</h2></div>
      <ul class="pr">{principles.map((p) => <li><Icon name="check" size={22} /><div><h3>{p.t}</h3><p>{p.d}</p></div></li>)}</ul>
    </div>
  </section>

  <section class="section">
    <div class="wrap local">
      <div>
        <h2>Holmestrand til Tønsberg-området</h2>
        <p class="lead">Levering, henting og befaring i Holmestrand, Horten og Tønsberg-området.</p>
        <ul class="kommuner">{site.areas.map((a) => <li><Icon name="pin" size={18} /> {a}</li>)}</ul>
        <img class="logo" src="/logo.png" alt="BoligButlers logo: en hånd som holder et hus med planter" width="669" height="552" loading="lazy" />
        <p class="muted">Bor du litt utenfor området? Ring og spør, så finner dere en løsning.</p>
      </div>
      <VestfoldMap class="om-map" />
    </div>
  </section>

  <CtaBand />
</Base>
<style>
  .intro { background: linear-gradient(180deg, var(--band), #fff); }
  .top { display: grid; grid-template-columns: 1.4fr 1fr; gap: clamp(2rem, 1rem + 4vw, 5rem); align-items: start; }
  .top p:not(.lead) { color: var(--ink-2); max-width: 40rem; }
  .founder { margin: 0; }
  .founder :global(.photo) { border-radius: 12px; }
  .founder figcaption { display: grid; margin-top: 0.75rem; line-height: 1.4; }
  .founder figcaption span { color: var(--ink-3); font-size: var(--step--1); }
  .vision { margin: clamp(2.5rem, 2rem + 2vw, 4rem) 0 0; padding: clamp(1.5rem, 1rem + 2vw, 2.5rem); background: var(--green); color: #fff; border-radius: 12px; }
  .vision p { font-size: var(--step-3); font-weight: 650; letter-spacing: -0.02em; line-height: 1.3; margin: 0 0 1rem; max-width: 26em; }
  .vision footer { color: var(--on-green-2); font-size: var(--step--1); }
  .work { list-style: none; padding: 0; margin: 0; display: grid; grid-template-columns: repeat(3, 1fr); gap: 1.5rem 1.25rem; }
  .work figure { margin: 0; display: grid; gap: 0.55rem; }
  .work figcaption { font-weight: 600; font-size: 0.97rem; }
  .logo { width: 9rem; height: auto; margin: 0 0 1.25rem; }
  @media (max-width: 860px) { .work { grid-template-columns: repeat(2, 1fr); } }
  @media (max-width: 480px) { .work { grid-template-columns: 1fr; } }
  .pr { list-style: none; padding: 0; margin: 0; display: grid; grid-template-columns: repeat(2, 1fr); gap: 1.25rem; }
  .pr li { display: flex; gap: 0.9rem; background: #fff; border: 1px solid var(--line); border-radius: 12px; padding: 1.5rem; }
  .pr li > :global(svg) { color: var(--green); flex: none; margin-top: 0.1rem; }
  .pr h3 { margin-bottom: 0.35rem; }
  .pr p { color: var(--ink-2); margin: 0; }
  .local { display: grid; grid-template-columns: 1fr 0.8fr; gap: clamp(2rem, 1rem + 4vw, 5rem); align-items: center; }
  .kommuner { list-style: none; padding: 0; margin: 1.5rem 0; display: grid; grid-template-columns: repeat(2, minmax(0, 13rem)); gap: 0.6rem 1.5rem; }
  .kommuner li { display: flex; gap: 0.5rem; align-items: center; font-weight: 600; }
  .kommuner :global(svg) { color: var(--green); }
  .local :global(.om-map) { max-width: 22rem; justify-self: center; width: 100%; }
  @media (max-width: 860px) {
    .top, .local { grid-template-columns: 1fr; }
    .founder { max-width: 22rem; }
    .pr { grid-template-columns: 1fr; }
  }
</style>
