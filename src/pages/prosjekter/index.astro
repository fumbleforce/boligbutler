---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Crumbs from '../../components/Crumbs.astro';
import Photo from '../../components/Photo.astro';
import CtaBand from '../../components/CtaBand.astro';

const projects = (await getCollection('prosjekter')).sort((a, b) => a.data.order - b.data.order);
---
<Base title="Prosjekter du kan gjøre selv i Vestfold" description="Drenering, terrasse, ny plen, maling, støttemur, gravearbeid og trær. Se hvilket utstyr som brukes, hva som følger med og hva BoligButler hjelper med i Vestfold.">
  <section class="section--tight section">
    <div class="wrap">
      <Crumbs items={[{ href: '', label: 'Prosjekter' }]} />
      <div class="head">
        <h1>Hva skal du gjøre?</h1>
        <p>BoligButler er bygget rundt prosjektene huseiere i Vestfold faktisk gjør, ikke rundt en maskinliste. Velg ditt, og se hva som skal til.</p>
      </div>
      <ul class="grid">
        {projects.map((p) => (
          <li>
            <a href={`/prosjekter/${p.id}/`}>
              <Photo name={`prosjekt-${p.id}`} position={p.id === 'drenering' ? '50% 62%' : 'center'} alt={`${p.data.navTitle} i Vestfold`} hint={`${p.data.navTitle.toLowerCase()} i Vestfold`} ratio="16 / 10" />
              <span class="t">{p.data.navTitle}</span>
              <span class="l">{p.data.lead}</span>
              <span class="e">Utstyr: {p.data.equipment.map((e) => e.name).join(', ')}</span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>
  <CtaBand heading="Står ikke prosjektet ditt her?" text="Mange uteprosjekter er kombinasjoner av disse. Beskriv hva du skal gjøre, så foreslår BoligButler et oppsett." />
</Base>
<style>
  .grid { list-style: none; padding: 0; margin: 0; display: grid; grid-template-columns: repeat(auto-fill, minmax(20rem, 1fr)); gap: 2.5rem 1.5rem; }
  .grid a { display: grid; gap: 0.6rem; align-content: start; text-decoration: none; color: var(--ink); }
  .t { font-weight: 700; font-size: var(--step-2); letter-spacing: -0.015em; margin-top: 0.4rem; }
  .grid a:hover .t { color: var(--green); text-decoration: underline; text-decoration-thickness: 2px; text-underline-offset: 0.18em; }
  .l { color: var(--ink-2); font-size: 0.97rem; }
  .e { font-size: var(--step--1); color: var(--ink-3); }
</style>
