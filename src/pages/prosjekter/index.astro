---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Crumbs from '../../components/Crumbs.astro';
import ProjectIcon from '../../components/ProjectIcon.astro';
import CtaBand from '../../components/CtaBand.astro';

const projects = (await getCollection('prosjekter')).sort((a, b) => a.data.order - b.data.order);
---
<Base title="Prosjekter du kan gjøre selv, med utstyr og veiledning" description="Drenering, terrasse, ny plen, maling, støttemur, gravearbeid og trær. Se hvilket utstyr som brukes, hva som følger med og hva BoligButler hjelper med.">
  <section class="section--tight section">
    <div class="wrap">
      <Crumbs items={[{ href: '', label: 'Prosjekter' }]} />
      <div class="section-head">
        <h1>Hva skal du gjøre?</h1>
        <p>BoligButler er bygget rundt prosjektene huseiere faktisk gjør, ikke rundt en maskinliste. Velg ditt, og se hva som skal til.</p>
      </div>
      <ul class="grid">
        {projects.map((p) => (
          <li>
            <a href={`/prosjekter/${p.id}/`}>
              <ProjectIcon slug={p.id} size={56} />
              <span class="t">{p.data.navTitle}</span>
              <span class="l">{p.data.lead}</span>
              <span class="e">{p.data.equipment.map((e) => e.name).join(' · ')}</span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>
  <CtaBand heading="Står ikke prosjektet ditt her?" text="Mange uteprosjekter er kombinasjoner av disse. Beskriv hva du skal gjøre, så foreslår BoligButler et oppsett." />
</Base>
<style>
  h1 { font-size: var(--step-4); }
  .grid { list-style: none; padding: 0; margin: 0; display: grid; grid-template-columns: repeat(auto-fill, minmax(19rem, 1fr)); gap: 1px; background: var(--line); border: 1px solid var(--line); }
  .grid a { display: grid; gap: 0.7rem; align-content: start; height: 100%; padding: 1.8rem; background: var(--paper); text-decoration: none; transition: background 0.15s; }
  .grid a:hover { background: var(--card); color: var(--ink); }
  .t { font-family: var(--serif); font-size: var(--step-2); margin-top: 0.5rem; }
  .l { color: var(--ink-2); font-size: 0.97rem; }
  .e { font-size: var(--step--1); color: var(--ink-3); border-top: 1px solid var(--line); padding-top: 0.7rem; margin-top: 0.3rem; }
</style>
