---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Crumbs from '../../components/Crumbs.astro';
import Icon from '../../components/Icon.astro';
import Photo from '../../components/Photo.astro';
import ProjectStarter from '../../components/ProjectStarter.astro';
import Faq from '../../components/Faq.astro';
import CtaBand from '../../components/CtaBand.astro';
import { site, standardKit } from '../../data/site';

export async function getStaticPaths() {
  const projects = await getCollection('prosjekter');
  return projects.map((p) => ({ params: { slug: p.id }, props: { project: p } }));
}

const { project } = Astro.props;
const d = project.data;
const { Content } = await render(project);
const guides = (await getCollection('guider')).filter((g) => g.data.project === project.id);
const url = `${site.url}/prosjekter/${project.id}/`;
const [h1Main, h1Sub] = d.title.split(' – ');

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'Service',
    name: d.title,
    serviceType: d.navTitle,
    description: d.description,
    url,
    provider: { '@id': `${site.url}/#virksomhet` },
    areaServed: [{ '@type': 'AdministrativeArea', name: 'Vestfold' }, ...site.areas.map((a) => ({ '@type': 'City', name: a }))],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Forside', item: `${site.url}/` },
      { '@type': 'ListItem', position: 2, name: 'Prosjekter', item: `${site.url}/prosjekter/` },
      { '@type': 'ListItem', position: 3, name: d.navTitle, item: url },
    ],
  },
  ...(d.faq.length
    ? [{ '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: d.faq.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })) }]
    : []),
];
---
<Base title={`${h1Main} i Vestfold`} description={d.description} jsonLd={jsonLd}>
  <section class="intro">
    <div class="wrap">
      <Crumbs items={[{ href: '/prosjekter/', label: 'Prosjekter' }, { href: '', label: d.navTitle }]} />
      <div class="intro-grid">
        <div>
          <h1>{h1Main}{h1Sub && <span class="visually-hidden"> – </span><span class="h1-sub">{h1Sub.charAt(0).toUpperCase() + h1Sub.slice(1)}</span>}</h1>
          <p class="lead">{d.lead}</p>
          <dl class="facts">
            <div><dt><Icon name="pin" size={18} /> Område</dt><dd>Hele Vestfold</dd></div>
            <div><dt><Icon name="list" size={18} /> Sesong</dt><dd>{d.season}</dd></div>
          </dl>
          {guides[0] && <p class="read">Vil du forstå jobben først? <a href={`/guider/${guides[0].id}/`}>Les guiden: {guides[0].data.title}</a></p>}
        </div>
        <div class="intro-media">
          <Photo name={`prosjekt-${project.id}`} position={project.id === 'drenering' ? '50% 62%' : 'center'} alt={`${d.navTitle} i Vestfold`} hint={`${d.navTitle.toLowerCase()}, fra et ekte prosjekt i Vestfold`} ratio="4 / 3" eager />
        </div>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap two">
      <div class="main-col">
        <h2>Utstyr som brukes</h2>
        <p class="muted">Du leier bare det prosjektet ditt faktisk trenger. Alt leveres og hentes hjemme hos deg.</p>
        <table class="eq">
          <tbody>
            {d.equipment.map((e) => (
              <tr><th scope="row">{e.name}</th><td>{e.note}</td></tr>
            ))}
          </tbody>
        </table>

        <h2 class="mt">Det BoligButler gjør</h2>
        <ul class="ticks">{d.butler.map((b) => <li><Icon name="check" size={20} /> <span>{b}</span></li>)}</ul>

        <div class="kit">
          <Icon name="kit" size={28} />
          <div>
            <h3>Prosjektkassen for {d.navTitle.toLowerCase()}</h3>
            <p>{d.kit.map((k, i) => (i ? k.charAt(0).toLowerCase() + k.slice(1) : k)).join(', ')}.</p>
            <p class="muted small">I tillegg til standardkassen med {standardKit.slice(0, 4).map((g) => g.group.toLowerCase()).join(', ')} og mer.</p>
          </div>
        </div>
      </div>
      <aside class="side">
        <ProjectStarter selected={project.id} heading={`Få forslag til ${d.navTitle.toLowerCase()}`} />
        <p class="side-call">Eller ring <a href={`tel:${site.phone.replace(/\s/g, '')}`}>{site.phoneDisplay}</a></p>
      </aside>
    </div>
  </section>

  <section class="section section--band">
    <div class="narrow">
      <div class="prose"><Content /></div>
    </div>
  </section>

  {d.notDiy.length > 0 && (
    <section class="section--tight section">
      <div class="narrow">
        <div class="honest">
          <h2>Når du bør overlate det til fagfolk</h2>
          <ul>{d.notDiy.map((n) => <li><Icon name="warning" size={20} /> <span>{n}</span></li>)}</ul>
          <p>BoligButler sier ifra hvis prosjektet ditt havner her, også om det betyr at du ikke leier noe.</p>
        </div>
      </div>
    </section>
  )}

  {guides.length > 0 && (
    <section class="section--tight section">
      <div class="wrap">
        <h2>Guider om {d.navTitle.toLowerCase()}</h2>
        <ul class="guides">
          {guides.map((g) => (
            <li><a href={`/guider/${g.id}/`}><span class="g-title">{g.data.title}</span><span class="g-sum">{g.data.description}</span></a></li>
          ))}
        </ul>
      </div>
    </section>
  )}

  <section class="section--tight section">
    <div class="narrow"><Faq items={d.faq} /></div>
  </section>

  <CtaBand heading={`Skal du i gang med ${d.navTitle.toLowerCase()}?`} project={project.id} />
</Base>

<style>
  .intro { padding-block: 1.75rem clamp(2.5rem, 2rem + 3vw, 4rem); background: linear-gradient(180deg, var(--band), #fff); }
  .intro-grid { display: grid; grid-template-columns: 1.1fr 1fr; gap: clamp(2rem, 1rem + 4vw, 4.5rem); align-items: center; }
  h1 { max-width: 15em; }
  .h1-sub { display: block; font-size: 0.48em; line-height: 1.3; color: var(--ink-2); font-weight: 500; letter-spacing: -0.01em; margin-top: 0.5em; }
  .facts { margin: 1.75rem 0 0; display: grid; gap: 0; border-top: 1px solid var(--line); max-width: 36rem; }
  .facts > div { display: grid; grid-template-columns: 8rem 1fr; gap: 1rem; padding: 0.75rem 0; border-bottom: 1px solid var(--line); }
  .facts dt { font-weight: 650; display: flex; gap: 0.45rem; align-items: center; }
  .facts dt :global(svg) { color: var(--green); }
  .facts dd { margin: 0; color: var(--ink-2); }
  .read { margin: 1.5rem 0 0; color: var(--ink-2); }
  .intro-media :global(.photo) { border-radius: var(--r); }

  .two { display: grid; grid-template-columns: minmax(0, 1.5fr) minmax(18rem, 1fr); gap: clamp(2rem, 1rem + 4vw, 4.5rem); align-items: start; }
  h2 { font-size: var(--step-2); }
  .mt { margin-top: 2.75rem; }
  .eq { width: 100%; border-collapse: collapse; border: 1px solid var(--line); border-radius: 12px; overflow: hidden; margin-top: 1.25rem; }
  .eq th, .eq td { text-align: left; padding: 0.9rem 1rem; border-bottom: 1px solid var(--line); vertical-align: top; }
  .eq tr:last-child th, .eq tr:last-child td { border-bottom: 0; }
  .eq th { font-weight: 650; width: 38%; background: var(--band); }
  .eq td { color: var(--ink-2); }
  .ticks { list-style: none; padding: 0; margin: 0; display: grid; gap: 0.75rem; }
  .ticks li { display: flex; gap: 0.6rem; align-items: flex-start; }
  .ticks :global(svg) { color: var(--green); flex: none; margin-top: 0.15rem; }
  .kit { display: flex; gap: 1rem; margin-top: 2.25rem; padding: 1.4rem; border-radius: 12px; background: var(--green-tint); }
  .kit > :global(svg) { color: var(--green); flex: none; }
  .kit h3 { margin-bottom: 0.3rem; }
  .kit p { margin: 0 0 0.4rem; }
  .side { position: sticky; top: 1.5rem; }
  .side-call { text-align: center; margin: 1rem 0 0; color: var(--ink-2); }
  .side-call a { font-weight: 650; }

  .honest { border: 1px solid var(--amber-line); background: var(--amber-bg); border-radius: 12px; padding: 1.6rem 1.8rem; }
  .honest ul { list-style: none; padding: 0; margin: 0; display: grid; gap: 0.6rem; }
  .honest li { display: flex; gap: 0.6rem; align-items: flex-start; }
  .honest li :global(svg) { color: var(--amber-ink); flex: none; margin-top: 0.15rem; }
  .honest p { color: var(--ink-2); margin: 1.1rem 0 0; }

  .guides { list-style: none; padding: 0; margin: 1.25rem 0 0; display: grid; grid-template-columns: repeat(auto-fill, minmax(17rem, 1fr)); gap: 1.25rem; }
  .guides a { display: grid; gap: 0.5rem; height: 100%; align-content: start; padding: 1.4rem; border: 1px solid var(--line); border-radius: 12px; text-decoration: none; color: var(--ink); transition: border-color 0.15s ease-out, background-color 0.15s ease-out; }
  .guides a:hover { border-color: var(--green); background: var(--green-tint); }
  .g-title { font-weight: 700; font-size: 1.1rem; line-height: 1.3; }
  .g-sum { color: var(--ink-2); font-size: 0.93rem; }

  @media (max-width: 900px) {
    .intro-grid, .two { grid-template-columns: 1fr; }
    .intro-media { order: -1; }
    .side { position: static; }
  }
  @media (max-width: 520px) { .facts > div { grid-template-columns: 1fr; gap: 0.15rem; } }
</style>
