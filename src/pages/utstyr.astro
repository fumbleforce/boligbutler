---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import Crumbs from '../components/Crumbs.astro';
import CtaBand from '../components/CtaBand.astro';
import Photo from '../components/Photo.astro';

const projects = (await getCollection('prosjekter')).sort((a, b) => a.data.order - b.data.order);
const map = new Map<string, { note: string; projects: { id: string; name: string }[] }>();
for (const p of projects) {
  for (const e of p.data.equipment) {
    const cur = map.get(e.name) ?? { note: e.note, projects: [] };
    cur.projects.push({ id: p.id, name: p.data.navTitle });
    map.set(e.name, cur);
  }
}
const gear: { name: string; label: string; alt: string; fit?: 'cover' | 'contain' }[] = [
  { name: 'utstyr-minigraver', label: 'Minigraver', alt: 'Minigraver, Volvo ECR25D, med skuffer' },
  { name: 'utstyr-dumper', label: 'Beltedumper', alt: 'Beltedumper, Kubota KC70VSL-4', fit: 'contain' },
  { name: 'utstyr-vibroplate', label: 'Vibroplate', alt: 'Vibroplate på avrettet settelag ved siden av belegningsstein' },
  { name: 'utstyr-maskinhenger', label: 'Maskinhenger', alt: 'Maskinhenger med ramper og minigraver' },
];
const items = [...map.entries()].sort((a, b) => b[1].projects.length - a[1].projects.length || a[0].localeCompare(b[0], 'nb'));
---
<Base title="Utstyr til leie med levering og veiledning" description="Minigraver, dumper, vibroplate, stillas, tilhenger, lift, flishugger og mer. Levert i hele Vestfold, med prosjektkasse og innføring.">
  <section class="section--tight section">
    <div class="wrap">
      <Crumbs items={[{ href: '', label: 'Utstyr' }]} />
            <div class="head">
        <h1>Utstyr</h1>
        <p>Listen er kort med vilje. BoligButler har utstyr som brukes i prosjektene huseiere faktisk gjør, og som en privatperson kan bruke trygt etter en innføring. Alt leveres og hentes i hele Vestfold, med prosjektkasse.</p>
      </div>
      <ul class="gear">
        {gear.map((g) => (
          <li><Photo name={g.name} alt={g.alt} hint={g.alt} ratio="4 / 3" fit={g.fit} /><span>{g.label}</span></li>
        ))}
      </ul>
      <table>
        <thead><tr><th scope="col">Utstyr</th><th scope="col">Brukes til</th><th scope="col">Prosjekter</th></tr></thead>
        <tbody>
          {items.map(([name, v]) => (
            <tr>
              <th scope="row">{name}</th>
              <td>{v.note}</td>
              <td>{v.projects.map((p, i) => <>{i > 0 && ', '}<a href={`/prosjekter/${p.id}/`}>{p.name}</a></>)}</td>
            </tr>
          ))}
        </tbody>
      </table>
      <p class="note">Usikker på hva du trenger? Start med <a href="/prosjekter/">prosjektet</a>, så følger utstyret av det.</p>
    </div>
  </section>
  <CtaBand />
</Base>
<style>
  .gear { list-style: none; padding: 0; margin: 0 0 3rem; display: grid; grid-template-columns: repeat(4, 1fr); gap: 1.25rem; }
  .gear li { display: grid; gap: 0.6rem; }
  .gear span { font-weight: 700; }
  @media (max-width: 900px) { .gear { grid-template-columns: repeat(2, 1fr); } }
  table { width: 100%; border-collapse: collapse; border: 1px solid var(--line); border-radius: 12px; overflow: hidden; }
  th, td { text-align: left; padding: 1rem 1.1rem; border-bottom: 1px solid var(--line); vertical-align: top; }
  tbody tr:last-child th, tbody tr:last-child td { border-bottom: 0; }
  thead th { font-size: var(--step--1); color: var(--ink-2); font-weight: 600; background: var(--band); }
  tbody th { font-weight: 700; font-size: 1.05rem; width: 26%; }
  td { color: var(--ink-2); }
  .note { margin-top: 2rem; }
  @media (max-width: 700px) {
    table { border: 0; }
    thead { display: none; }
    tr { display: grid; padding: 1rem 0; border-bottom: 1px solid var(--line); }
    th, td { border: 0; padding: 0.15rem 0; width: auto !important; }
  }
</style>
