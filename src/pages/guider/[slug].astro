---
import { getCollection, getEntry, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Crumbs from '../../components/Crumbs.astro';
import Faq from '../../components/Faq.astro';
import CtaBand from '../../components/CtaBand.astro';
import Icon from '../../components/Icon.astro';
import { site } from '../../data/site';

export async function getStaticPaths() {
  const guides = await getCollection('guider');
  return guides.map((g) => ({ params: { slug: g.id }, props: { guide: g } }));
}

const { guide } = Astro.props;
const d = guide.data;
const { Content, headings } = await render(guide);
const toc = headings.filter((h) => h.depth === 2);
const project = await getEntry('prosjekter', d.project);
const related = (await getCollection('guider'))
  .filter((g) => g.id !== guide.id)
  .sort((a, b) => Number(b.data.project === d.project) - Number(a.data.project === d.project))
  .slice(0, 3);

const url = `${site.url}/guider/${guide.id}/`;
const iso = d.updated.toISOString().slice(0, 10);
const dateText = d.updated.toLocaleDateString('nb-NO', { day: 'numeric', month: 'long', year: 'numeric' });

const jsonLd: object[] = [
  {
    '@context': 'https://schema.org',
    '@type': 'Article',
    headline: d.title,
    description: d.description,
    abstract: d.summary,
    inLanguage: 'nb-NO',
    dateModified: iso,
    datePublished: iso,
    mainEntityOfPage: url,
    author: { '@type': 'Organization', name: 'BoligButler', url: site.url },
    publisher: { '@id': `${site.url}/#virksomhet` },
    about: project?.data.navTitle,
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Forside', item: `${site.url}/` },
      { '@type': 'ListItem', position: 2, name: 'Guider', item: `${site.url}/guider/` },
      { '@type': 'ListItem', position: 3, name: d.title, item: url },
    ],
  },
];
if (d.steps?.length) {
  jsonLd.push({
    '@context': 'https://schema.org',
    '@type': 'HowTo',
    name: d.title,
    description: d.summary,
    tool: d.equipment.map((e) => ({ '@type': 'HowToTool', name: e })),
    step: d.steps.map((s, i) => ({ '@type': 'HowToStep', position: i + 1, name: s.name, text: s.text })),
  });
}
if (d.faq.length) {
  jsonLd.push({
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: d.faq.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
  });
}
---
<Base title={d.title} description={d.description} jsonLd={jsonLd} ogType="article">
  <article>
    <header class="ghead">
      <div class="narrow">
        <Crumbs items={[{ href: '/guider/', label: 'Guider' }, { href: '', label: d.title }]} />
        <h1>{d.title}</h1>
        <ul class="meta">
          <li>Vanskelighetsgrad: <strong>{d.difficulty}</strong></li>
          {d.timeEstimate && <li>Tid: <strong>{d.timeEstimate}</strong></li>}
          <li>Oppdatert <time datetime={iso}>{dateText}</time></li>
        </ul>
        <div class="answer">
          <h2 class="answer-h">Kort svar</h2>
          <p>{d.summary}</p>
        </div>
      </div>
    </header>

    <div class="layout wrap">
      <aside class="side">
        {toc.length > 2 && (
          <nav class="toc" aria-label="Innhold i guiden">
            <h2 class="side-h">I denne guiden</h2>
            <ol>{toc.map((h) => <li><a href={`#${h.slug}`}>{h.text}</a></li>)}</ol>
          </nav>
        )}
        {project && (
          <div class="rent">
            <h2 class="side-h">Utstyr til denne jobben</h2>
            {d.equipment.length > 0 && <ul>{d.equipment.map((e) => <li><Icon name="check" size={16} /> {e}</li>)}</ul>}
            <p class="small">Levert i hele Vestfold, med innføring og prosjektkasse.</p>
            <a class="btn" href={`/prosjekter/${project.id}/`}>Se {project.data.navTitle.toLowerCase()}</a>
          </div>
        )}
      </aside>
      <div class="prose body">
        <Content />
      </div>
    </div>

    <div class="narrow after">
      <Faq items={d.faq} heading="Spørsmål folk stiller" />
      <p class="by">Skrevet av BoligButler, som leier ut utstyr med veiledning til huseiere i hele Vestfold. Guiden gir generelle råd. Regelverk og forhold på tomta varierer, så sjekk alltid med kommunen ved tvil.</p>
    </div>
  </article>

  <section class="section--tight section section--band">
    <div class="wrap">
      <h2>Les videre</h2>
      <ul class="rel">
        {related.map((g) => (
          <li><a href={`/guider/${g.id}/`}><span class="r-title">{g.data.title}</span><span class="r-sum">{g.data.description}</span></a></li>
        ))}
      </ul>
    </div>
  </section>

  <CtaBand heading="Vil du ha noen å spørre underveis?" text="Med BoligButler får du utstyret levert, en innføring på stedet og en rådgiver på telefon. Du bestemmer hvor mye hjelp du vil ha." />
</Base>

<style>
  .ghead { padding-block: 1.75rem 2.5rem; background: linear-gradient(180deg, var(--band), #fff); }
  h1 { font-size: var(--step-4); }
  .meta { list-style: none; padding: 0; margin: 1rem 0 0; display: flex; flex-wrap: wrap; gap: 0.4rem 1.5rem; font-size: var(--step--1); color: var(--ink-2); }
  .meta strong { color: var(--ink); font-weight: 600; }
  .answer { margin-top: 2rem; background: var(--green-tint); border-radius: 12px; padding: 1.3rem 1.5rem; }
  .answer-h { font-size: 1rem; color: var(--green); margin: 0 0 0.35rem; letter-spacing: 0; }
  .answer p { font-size: var(--step-1); line-height: 1.55; margin: 0; }

  .layout { display: grid; grid-template-columns: 15.5rem minmax(0, 46rem); gap: clamp(2rem, 1rem + 4vw, 5rem); justify-content: center; padding-bottom: 3rem; }
  .side { position: sticky; top: 1.5rem; align-self: start; display: grid; gap: 1.75rem; font-size: 0.93rem; }
  .side-h { font-size: 0.95rem; letter-spacing: 0; margin: 0 0 0.6rem; }
  .toc ol { list-style: none; padding: 0; margin: 0; border-left: 2px solid var(--line); }
  .toc li a { display: block; padding: 0.35rem 0 0.35rem 0.9rem; margin-left: -2px; text-decoration: none; color: var(--ink-2); line-height: 1.35; border-left: 2px solid transparent; }
  .toc li a:hover { color: var(--green); border-left-color: var(--green); }
  .rent { border: 1px solid var(--line); border-radius: 12px; padding: 1.2rem; }
  .rent ul { list-style: none; padding: 0; margin: 0 0 0.75rem; display: grid; gap: 0.35rem; color: var(--ink-2); }
  .rent li { display: flex; gap: 0.4rem; align-items: center; }
  .rent li :global(svg) { color: var(--green); }
  .rent .small { color: var(--ink-3); }
  .rent .btn { width: 100%; min-height: 2.6rem; font-size: 0.93rem; }

  .after { padding-bottom: 3rem; }
  .by { margin-top: 2.5rem; font-size: var(--step--1); color: var(--ink-3); border-top: 1px solid var(--line); padding-top: 1rem; }

  .rel { list-style: none; padding: 0; margin: 1rem 0 0; display: grid; grid-template-columns: repeat(3, 1fr); gap: 1.25rem; }
  .rel a { display: grid; gap: 0.5rem; height: 100%; align-content: start; padding: 1.4rem; background: #fff; border: 1px solid var(--line); border-radius: 12px; text-decoration: none; color: var(--ink); transition: border-color 0.15s ease-out, background-color 0.15s ease-out; }
  .rel a:hover { border-color: var(--green); background: var(--green-tint); }
  .r-title { font-weight: 700; font-size: 1.1rem; line-height: 1.3; }
  .r-sum { color: var(--ink-2); font-size: 0.93rem; }

  @media (max-width: 960px) {
    .layout { grid-template-columns: minmax(0, 46rem); }
    .side { position: static; order: 2; }
    .toc { display: none; }
    .rel { grid-template-columns: 1fr; }
  }
</style>
