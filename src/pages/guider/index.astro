---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Crumbs from '../../components/Crumbs.astro';
import Icon from '../../components/Icon.astro';
import CtaBand from '../../components/CtaBand.astro';
import { site } from '../../data/site';

const projects = (await getCollection('prosjekter')).sort((a, b) => a.data.order - b.data.order);
const guides = await getCollection('guider');
const groups = projects
  .map((p) => ({ project: p, items: guides.filter((g) => g.data.project === p.id).sort((a, b) => a.data.title.localeCompare(b.data.title, 'nb')) }))
  .filter((g) => g.items.length);

const jsonLd = [{
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: 'Guider for huseiere som gjør det selv',
  url: `${site.url}/guider/`,
  hasPart: guides.map((g) => ({ '@type': 'Article', headline: g.data.title, url: `${site.url}/guider/${g.id}/` })),
}];
---
<Base title="Guider: slik gjør du det selv på hus, hage og tomt" description="Praktiske guider om drenering, terrasse, støttemur, plen, maling, stillas, minigraver og tilhenger. Mål, fremgangsmåter og vanlige feil, for deg som gjør jobben selv." jsonLd={jsonLd}>
  <section class="section--tight section">
    <div class="wrap">
      <Crumbs items={[{ href: '', label: 'Guider' }]} />
      <div class="head">
        <h1>Guider for deg som gjør det selv</h1>
        <p>Fremgangsmåter, mål og vanlige feil fra prosjekter på hus, hage og tomt, skrevet for norske forhold. Du kan bruke dem selv om du aldri leier noe.</p>
      </div>
      <p class="tool"><Icon name="list" size={20} /> Skal du bestille pukk, grus eller jord? <a href="/verktoy/massekalkulator/">Bruk massekalkulatoren</a>.</p>
      {groups.map(({ project, items }) => (
        <section class="group" aria-labelledby={`g-${project.id}`}>
          <h2 id={`g-${project.id}`}><a href={`/prosjekter/${project.id}/`}>{project.data.navTitle}</a></h2>
          <ul>
            {items.map((g) => (
              <li>
                <a href={`/guider/${g.id}/`}>
                  <span class="t">{g.data.title}</span>
                  <span class="s">{g.data.description}</span>
                  <span class="d">{g.data.difficulty}</span>
                </a>
              </li>
            ))}
          </ul>
        </section>
      ))}
    </div>
  </section>
  <CtaBand />
</Base>
<style>
  .tool { display: flex; gap: 0.6rem; align-items: center; flex-wrap: wrap; padding: 1rem 1.25rem; background: var(--green-tint); border-radius: 12px; max-width: 46rem; }
  .tool :global(svg) { color: var(--green); }
  .group { display: grid; grid-template-columns: 14rem 1fr; gap: 2rem; border-top: 1px solid var(--line); padding-top: 1.5rem; margin-top: 2.5rem; }
  .group h2 { font-size: var(--step-2); }
  .group h2 a { color: var(--ink); text-decoration: none; }
  .group h2 a:hover { color: var(--green); }
  .group ul { list-style: none; padding: 0; margin: 0; display: grid; grid-template-columns: repeat(auto-fill, minmax(18rem, 1fr)); gap: 1rem; }
  .group li a { display: grid; gap: 0.4rem; height: 100%; align-content: start; padding: 1.25rem 1.4rem; border: 1px solid var(--line); border-radius: 12px; text-decoration: none; color: var(--ink); transition: border-color 0.15s ease-out, background-color 0.15s ease-out; }
  .group li a:hover { border-color: var(--green); background: var(--green-tint); }
  .t { font-weight: 700; font-size: 1.1rem; line-height: 1.3; }
  .s { color: var(--ink-2); font-size: 0.93rem; }
  .d { font-size: var(--step--1); color: var(--green); font-weight: 600; }
  @media (max-width: 760px) { .group { grid-template-columns: 1fr; gap: 0.75rem; } }
</style>
