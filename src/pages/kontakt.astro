---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import Crumbs from '../components/Crumbs.astro';
import { site, extras } from '../data/site';
import Icon from '../components/Icon.astro';

const projects = (await getCollection('prosjekter')).sort((a, b) => a.data.order - b.data.order);
---
<Base title="Beskriv prosjektet ditt" description="Fortell BoligButler hva du skal gjøre, så får du forslag til utstyr og pris. Levering fra Holmestrand til Tønsberg-området.">
  <section class="section--tight section page">
    <div class="wrap grid">
      <div class="intro">
        <Crumbs items={[{ href: '', label: 'Kontakt' }]} />
        <h1>Beskriv prosjektet ditt</h1>
        <p class="lead">Noen få opplysninger er nok. BoligButler svarer med forslag til utstyr og rekkefølge, og pris før du bestemmer deg.</p>
        <ul class="direct">
          <li><Icon name="phone" size={22} /><div><span>Telefon</span><a href={`tel:${site.phone.replace(/\s/g, '')}`}>{site.phoneDisplay}</a></div></li>
          <li><Icon name="mail" size={22} /><div><span>E-post</span><a href={`mailto:${site.email}`}>{site.email}</a></div></li>
          <li><Icon name="pin" size={22} /><div><span>Område</span><strong>Holmestrand til Tønsberg-området</strong><small>Base: {site.address.street}, {site.address.postalCode} {site.address.city}</small><small>{site.areas.join(', ')}</small></div></li>
        </ul>
        <p class="promise">Du får et forslag med utstyr og pris. Det er gratis og forplikter deg ikke til noe.</p>
      </div>

      <!-- TODO: koble skjemaet til en skjematjeneste (f.eks. Formspree, Netlify Forms eller egen e-post-API). Nå åpner det e-postprogrammet med utfylt tekst. -->
      <form id="plan" class="form" data-email={site.email}>
        <fieldset>
          <legend>1. Hva skal du gjøre?</legend>
          <div class="chips">
            {projects.map((p) => (
              <label class="chip"><input type="radio" name="prosjekt" value={p.data.navTitle} data-slug={p.id} required /> <span>{p.data.navTitle}</span></label>
            ))}
            <label class="chip"><input type="radio" name="prosjekt" value="Annet" data-slug="annet" /> <span>Noe annet</span></label>
          </div>
        </fieldset>

        <fieldset>
          <legend>2. Ønsker du hjelp utover utstyret? <span class="opt-note">(valgfritt)</span></legend>
          <div class="chips">
            {extras.map((e, i) => (
              <label class="chip"><input type="checkbox" name="hjelp" value={e.short} id={`hjelp-${i}`} /> <span>{e.short}</span></label>
            ))}
          </div>
          <p class="hint">Levering, innføring og prosjektkasse er alltid med. Er du usikker, la det stå tomt, så foreslår BoligButler.</p>
        </fieldset>

        <fieldset>
          <legend>3. Litt om prosjektet</legend>
          <label class="field">Beskriv kort hva som skal gjøres
            <textarea name="beskrivelse" rows="5" placeholder="F.eks. drenere langs to sider av huset, ca. 25 meter, mye leire. Tilkomst med maskin fra innkjørselen."></textarea>
          </label>
          <div class="row">
            <label class="field">Når vil du starte?
              <select name="tid">
                <option>Så snart som mulig</option>
                <option>Innen en måned</option>
                <option>Neste sesong</option>
                <option>Jeg planlegger bare foreløpig</option>
              </select>
            </label>
            <label class="field">Kommune
              <select name="kommune" required>
                <option value="" selected disabled>Velg kommune</option>
                {site.areas.map((a) => <option>{a}</option>)}
                <option value="Annet">Utenfor Vestfold</option>
              </select>
            </label>
          </div>
        </fieldset>

        <fieldset>
          <legend>4. Hvordan når BoligButler deg?</legend>
          <div class="row">
            <label class="field">Navn<input name="navn" autocomplete="name" required /></label>
            <label class="field">Telefon<input name="telefon" type="tel" autocomplete="tel" required /></label>
          </div>
          <label class="field">E-post (valgfritt)<input name="epost" type="email" autocomplete="email" /></label>
        </fieldset>

        <button class="btn" type="submit">Send forespørsel <Icon name="arrow" size={18} /></button>
        <p class="fine">Opplysningene brukes bare til å svare deg om prosjektet.</p>
      </form>
    </div>
  </section>
</Base>

<script>
  const form = document.getElementById('plan') as HTMLFormElement | null;
  if (form) {
    const pre = new URLSearchParams(location.search).get('prosjekt');
    if (pre) {
      const r = form.querySelector<HTMLInputElement>(`input[data-slug="${CSS.escape(pre)}"]`);
      if (r) r.checked = true;
    }
    const kom = new URLSearchParams(location.search).get('kommune');
    const sel = form.querySelector<HTMLSelectElement>('select[name="kommune"]');
    if (kom && sel && [...sel.options].some((o) => o.value === kom)) sel.value = kom;
    form.addEventListener('submit', (e) => {
      e.preventDefault();
      if (!form.reportValidity()) return;
      const fd = new FormData(form);
      const lines = [
        `Prosjekt: ${fd.get('prosjekt')}`,
        `Ønsket hjelp: ${fd.getAll('hjelp').join(', ') || 'Bare utstyret / vet ikke ennå'}`,
        `Oppstart: ${fd.get('tid')}`,
        `Kommune: ${fd.get('kommune')}`,
        '',
        `${fd.get('beskrivelse') || ''}`,
        '',
        `Navn: ${fd.get('navn')}`,
        `Telefon: ${fd.get('telefon')}`,
        `E-post: ${fd.get('epost') || ''}`,
      ];
      const subject = `Prosjekt: ${fd.get('prosjekt')} (${fd.get('kommune')})`;
      location.href = `mailto:${form.dataset.email}?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(lines.join('\n'))}`;
    });
  }
</script>

<style>
  .page { background: linear-gradient(180deg, var(--band), #fff 60%); }
  .grid { display: grid; grid-template-columns: 1fr 1.4fr; gap: clamp(2rem, 1rem + 4vw, 5rem); align-items: start; }
  .intro { position: sticky; top: 1.5rem; }
  .direct { list-style: none; padding: 0; margin: 2rem 0 0; display: grid; gap: 1.25rem; }
  .direct li { display: flex; gap: 0.9rem; align-items: flex-start; }
  .direct li > :global(svg) { color: var(--green); flex: none; margin-top: 0.2rem; }
  .direct div { display: grid; line-height: 1.4; }
  .direct span { font-size: var(--step--1); color: var(--ink-3); }
  .direct a, .direct strong { font-size: 1.15rem; font-weight: 650; }
  .direct small { color: var(--ink-2); font-size: 0.9rem; }
  .promise { margin-top: 2rem; padding: 1rem 1.2rem; background: var(--green-tint); border-radius: 12px; color: var(--ink); }
  .form { background: #fff; border: 1px solid var(--line); padding: clamp(1.25rem, 1rem + 2vw, 2.5rem); border-radius: 12px; }
  fieldset { border: 0; padding: 0; margin: 0 0 2rem; min-width: 0; }
  legend { font-weight: 700; font-size: var(--step-1); margin-bottom: 0.9rem; padding: 0; letter-spacing: -0.01em; }
  .chips { display: flex; flex-wrap: wrap; gap: 0.5rem; }
  .chip input, .opt input { position: absolute; opacity: 0; pointer-events: none; }
  .chip span { display: inline-block; padding: 0.6rem 1rem; border: 1px solid var(--line-2); border-radius: 999px; cursor: pointer; background: #fff; font-size: 0.95rem; transition: border-color 0.15s ease-out, background-color 0.15s ease-out; }
  .chip span:hover { border-color: var(--green); }
  .chip input:checked + span { border-color: var(--green); background: var(--green); color: #fff; }
  .chip input:focus-visible + span, .opt input:focus-visible + span { outline: 2px solid var(--green); outline-offset: 2px; }
  .opt-note { font-weight: 400; font-size: 0.9rem; color: var(--ink-3); }
  .hint { font-size: var(--step--1); color: var(--ink-3); margin: 0.75rem 0 0; }
  .opts { display: grid; gap: 0.5rem; }
  .opt span { display: block; padding: 0.85rem 1rem; border: 1px solid var(--line-2); border-radius: var(--r); cursor: pointer; background: #fff; color: var(--ink-2); font-size: 0.95rem; }
  .opt span:hover { border-color: var(--green); }
  .opt strong { color: var(--ink); }
  .opt input:checked + span { border-color: var(--green); background: var(--green-tint); box-shadow: inset 0 0 0 1px var(--green); }
  .field { margin-bottom: 1rem; }
  .row { display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; }
  .form .btn { width: 100%; }
  .fine { font-size: var(--step--1); color: var(--ink-3); margin-top: 1rem; text-align: center; }
  @media (max-width: 860px) { .grid { grid-template-columns: 1fr; } .intro { position: static; } }
  @media (max-width: 520px) { .row { grid-template-columns: 1fr; } }
</style>
