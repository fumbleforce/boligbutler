---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import Photo from '../components/Photo.astro';
import ProjectStarter from '../components/ProjectStarter.astro';
import VestfoldMap from '../components/VestfoldMap.astro';
import Faq from '../components/Faq.astro';
import CtaBand from '../components/CtaBand.astro';
import { site, included, extras } from '../data/site';

const projects = (await getCollection('prosjekter')).sort((a, b) => a.data.order - b.data.order);
const guides = await getCollection('guider');
const featuredSlugs = ['drenering-rundt-huset', 'bygge-terrasse', 'leie-minigraver', 'tilhenger-forerkort'];
const featured = featuredSlugs.map((s) => guides.find((g) => g.id === s)).filter((g) => g !== undefined);
const tel = `tel:${site.phone.replace(/\s/g, '')}`;

const steps = [
  { t: 'Du forteller hva du skal gjøre', d: 'Velg prosjekt og sted, og beskriv jobben med noen setninger. Ring gjerne hvis det er enklere.' },
  { t: 'Du får forslag og pris', d: 'Utstyr, rekkefølge og hvor mye hjelp som passer. Ved større jobber kommer BoligButler på befaring først.' },
  { t: 'Utstyret kommer til deg', d: 'Levert dit det skal brukes, med prosjektkasse og en innføring i trygg bruk før du starter.' },
  { t: 'Du gjør jobben, med støtte', d: 'Lurer du på noe, ringer du. Når du er ferdig, hentes utstyret igjen.' },
];

const faq = [
  { q: 'Hva er forskjellen på BoligButler og et vanlig maskinutleie?', a: 'BoligButler tar utgangspunkt i prosjektet ditt, ikke i maskinen. Du får utstyret levert, en innføring på stedet, en prosjektkasse med det som pleier å mangle, og en rådgiver du kan ringe eller få på befaring.' },
  { q: 'Hvor leverer BoligButler?', a: `Primært fra Holmestrand i nord til Tønsberg-området i sør og øst: ${site.areas.join(', ')}. Bor du litt utenfor, ta kontakt, så finner dere en løsning.` },
  { q: 'Må jeg kjøpe rådgivning for å leie utstyr?', a: 'Nei. Kunden bestemmer. Råd gir BoligButler når du spør. Instruksjon i trygg bruk av utstyret får du alltid, fordi det handler om sikkerheten din.' },
  { q: 'Hva koster det?', a: 'Prisen avhenger av prosjektet, utstyret og hvor lenge du trenger det. Du får et konkret tilbud før du bestemmer deg, og det er gratis å spørre.' },
];

const jsonLd = [
  { '@context': 'https://schema.org', '@type': 'WebSite', name: site.name, url: site.url, inLanguage: 'nb-NO' },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faq.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
  },
];
---
<Base
  title="BoligButler – utstyr med rådgiver for hjemmeprosjekter i Vestfold"
  description="Lei minigraver, stillas, henger og mer med levering fra Holmestrand til Tønsberg-området. BoligButler gir innføring på stedet og veiledning underveis, for deg som gjør prosjektet selv."
  jsonLd={jsonLd}
>
  <section class="hero">
    <div class="wrap hero-grid">
      <div class="hero-text">
        <h1>Veiledning og utstyr til ditt prosjekt</h1>
        <p class="lead">
          Minigraver, stillas, henger og annet utstyr levert hjem fra Holmestrand til Tønsberg-området, med en erfaren rådgiver som viser deg hvordan og er tilgjengelig underveis.
        </p>
        <ul class="promises">
          <li><Icon name="check" size={20} /> Levert og hentet hjemme hos deg</li>
          <li><Icon name="check" size={20} /> Innføring på stedet før du starter</li>
          <li><Icon name="check" size={20} /> Pris før du bestemmer deg</li>
        </ul>
        <p class="call">Vil du heller snakke med noen? <a href={tel}>Ring {site.phoneDisplay}</a></p>
      </div>
      <div class="hero-media">
        <Photo name="hero" class="hero-photo" alt="Erling Eri ved en nylagt innkjørsel med belegningsstein og vibroplate" hint="et prosjekt i Vestfold" ratio="4 / 3" position="40% 40%" eager />
        <ProjectStarter class="hero-starter" />
      </div>
    </div>
  </section>

  <section class="assure" aria-label="Dette får du med BoligButler">
    <ul class="wrap assure-row">
      <li><Icon name="pin" size={26} /><div><strong>Lokal i Vestfold</strong><span>Levering fra Holmestrand til Tønsberg</span></div></li>
      <li><Icon name="person" size={26} /><div><strong>En rådgiver du kan ringe</strong><span>Råd når du spør, hjelp når du trenger det</span></div></li>
      <li><Icon name="kit" size={26} /><div><strong>Prosjektkasse følger med</strong><span>Måleutstyr, verneutstyr og småverktøy</span></div></li>
      <li><Icon name="warning" size={26} /><div><strong>Sikkerhet er ikke valgfritt</strong><span>Alltid instruksjon i trygg bruk</span></div></li>
    </ul>
  </section>

  <section id="prosjekter" class="section">
    <div class="wrap">
      <div class="head head--row">
        <div>
          <h2>Hva skal du gjøre?</h2>
          <p>Velg prosjektet, så ser du hvilket utstyr som brukes, hva som følger med og hva BoligButler kan hjelpe med.</p>
        </div>
        <a class="all" href="/prosjekter/">Alle prosjekter <Icon name="arrow" size={18} /></a>
      </div>
      <ul class="projects">
        {projects.map((p, i) => (
          <li class:list={{ wide: i < 2 }}>
            <a href={`/prosjekter/${p.id}/`}>
              <Photo name={`prosjekt-${p.id}`} position={p.id === "plen" ? "50% 35%" : p.id === "drenering" ? "50% 62%" : "center"} alt={`${p.data.navTitle}: prosjekt i Vestfold`} hint={`${p.data.navTitle.toLowerCase()} i Vestfold`} ratio={i < 2 || i >= 5 ? '16 / 10' : '4 / 3'} />
              <span class="p-body">
                <span class="p-title">{p.data.navTitle}</span>
                <span class="p-eq">{p.data.equipment.slice(0, 3).map((e) => e.name).join(', ')}</span>
              </span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="section section--band">
    <div class="wrap">
      <div class="head">
        <h2>Slik fungerer det</h2>
        <p>Fra første telefon til utstyret er hentet igjen. Du bestemmer hvor mye hjelp du vil ha.</p>
      </div>
      <ol class="steps">
        {steps.map((s, i) => (
          <li><span class="n" aria-hidden="true">{i + 1}</span><h3>{s.t}</h3><p>{s.d}</p></li>
        ))}
      </ol>
      <a class="btn btn--ghost" href="/slik-fungerer-det/">Les mer om hvordan det foregår</a>
    </div>
  </section>

  <section class="section">
    <div class="wrap person">
      <Photo name="grunnlegger" alt={`${site.founder.name}, ${site.founder.role.toLowerCase()} i BoligButler`} hint="portrett av grunnleggeren, gjerne ute ved utstyret" ratio="4 / 5" position="50% 35%" />
      <div class="person-text">
        <h2>Den som leverer, er den du kan ringe</h2>
        <p class="lead">BoligButler er en lokal virksomhet i Vestfold. Den som leverer utstyret og viser deg hvordan det brukes, er den samme du ringer når du står midt i grøfta med et spørsmål.</p>
        <dl class="levels">
          <div><dt>Råd</dt><dd>når du spør. Du får en ærlig vurdering, og du bestemmer.</dd></div>
          <div><dt>Veiledning</dt><dd>når det er naturlig, ved levering og befaring.</dd></div>
          <div class="must"><dt><Icon name="warning" size={18} /> Instruksjon</dt><dd>alltid når sikkerheten krever det. Grøftekant, stillasforankring og maskinbruk er ikke valgfritt.</dd></div>
        </dl>
        <p class="sign"><strong>{site.founder.name}</strong><br /><span class="muted">{site.founder.role}, BoligButler</span></p>
        <p class="more-work"><a href="/om/">Se bilder fra tidligere prosjekter</a></p>
      </div>
    </div>
  </section>

  <section class="section section--green local">
    <div class="wrap local-grid">
      <div class="local-text">
        <h2>Lokal i Horten og omegn</h2>
        <p class="local-lead">BoligButler holder til i Horten og leverer, henter og kommer på befaring fra Holmestrand i nord til Tønsberg-området i sør og øst. Kjent med leirjorda, kystklimaet og tomtene her.</p>
        <ul class="kommuner">
          {site.areas.map((a) => <li><Icon name="check" size={18} /> {a}</li>)}
        </ul>
        <p class="local-note">Bor du litt utenfor? <a href={tel}>Ring og spør</a>.</p>
      </div>
      <VestfoldMap class="local-map" />
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <div class="head">
        <h2>Du bestemmer hvor mye hjelp du vil ha</h2>
        <p>Utstyret kommer alltid med levering, innføring og prosjektkasse. Resten legger du til hvis du vil, og du får pris før du bestemmer deg.</p>
      </div>
      <div class="offer">
        <div class="offer-col offer-col--base">
          <h3>Alltid med</h3>
          <ul>{included.map((i) => <li><Icon name="check" size={18} /> <span>{i}</span></li>)}</ul>
        </div>
        <div class="offer-col">
          <h3>Når du ønsker det</h3>
          <ul>{extras.map((e) => <li><Icon name="person" size={18} /> <span>{e.text}</span></li>)}</ul>
        </div>
      </div>
    </div>
  </section>

  <section class="section section--band">
    <div class="wrap">
      <div class="head head--row">
        <div>
          <h2>Guider for deg som gjør det selv</h2>
          <p>Slik gjør du jobben, og feilene som er verdt å unngå. Gratis å lese, enten du leier av BoligButler eller ikke.</p>
        </div>
        <a class="all" href="/guider/">Alle guider <Icon name="arrow" size={18} /></a>
      </div>
      <ul class="guides">
        {featured.map((g) => (
          <li>
            <a href={`/guider/${g.id}/`}>
              <span class="g-title">{g.data.title}</span>
              <span class="g-sum">{g.data.description}</span>
              <span class="g-meta">{g.data.difficulty}{g.data.timeEstimate && `, ${g.data.timeEstimate.split(',')[0]}`}</span>
            </a>
          </li>
        ))}
      </ul>
      <p class="tool"><Icon name="list" size={20} /> Skal du bestille pukk, grus eller jord? <a href="/verktoy/massekalkulator/">Regn ut mengden med massekalkulatoren</a>.</p>
    </div>
  </section>

  <section class="section">
    <div class="narrow">
      <Faq items={faq} />
    </div>
  </section>

  <CtaBand />
</Base>

<style>
  .hero { padding-block: clamp(2rem, 1.5rem + 3vw, 4.5rem) clamp(3rem, 2rem + 4vw, 5.5rem); background: linear-gradient(180deg, var(--band), #fff 85%); }
  .hero-grid { display: grid; grid-template-columns: 1fr 1.05fr; gap: clamp(2rem, 1rem + 4vw, 4.5rem); align-items: center; }
  .hero h1 { max-width: 13em; margin-bottom: 0.45em; }
  .hero .lead { margin-bottom: 1.5rem; }
  .promises { list-style: none; padding: 0; margin: 0 0 1.75rem; display: grid; gap: 0.6rem; }
  .promises li { display: flex; gap: 0.6rem; align-items: center; font-weight: 550; }
  .promises :global(svg) { color: var(--green); flex: none; }
  .call { color: var(--ink-2); margin: 0; }
  .call a { font-weight: 650; white-space: nowrap; }
  .hero-media { position: relative; }
  .hero-media :global(.hero-photo.photo--empty) { place-content: start end; justify-items: end; text-align: right; }
  .hero-media :global(.hero-photo.photo--empty span) { max-width: 16rem; }
  :global(.hero-starter) { position: relative; margin: -4.5rem 0 0 -2.5rem; width: min(22rem, 75%); }

  .assure { border-block: 1px solid var(--line); background: #fff; }
  .assure-row { list-style: none; margin-inline: auto; padding: 0; display: grid; grid-template-columns: repeat(4, 1fr); }
  .assure li { display: flex; gap: 0.8rem; align-items: flex-start; padding: 1.5rem 1.25rem; }
  .assure li + li { border-left: 1px solid var(--line); }
  .assure li:first-child { padding-left: 0; }
  .assure :global(svg) { color: var(--green); flex: none; margin-top: 0.1rem; }
  .assure strong { display: block; font-weight: 650; line-height: 1.3; }
  .assure span { display: block; font-size: var(--step--1); color: var(--ink-3); line-height: 1.4; margin-top: 0.2rem; }

  .head--row { display: flex; justify-content: space-between; align-items: flex-end; gap: 2rem; max-width: none; }
  .head--row > div { display: grid; gap: 0.75rem; max-width: 44rem; }
  .all { display: inline-flex; align-items: center; gap: 0.4rem; font-weight: 600; text-decoration: none; white-space: nowrap; }
  .all:hover { text-decoration: underline; }

  .projects { list-style: none; padding: 0; margin: 0; display: grid; grid-template-columns: repeat(6, 1fr); gap: 1.5rem 1.25rem; }
  .projects li { grid-column: span 2; }
  .projects li.wide { grid-column: span 3; }
  .projects li:nth-child(n + 6) { grid-column: span 3; }
  .projects a { display: grid; gap: 0.85rem; text-decoration: none; color: var(--ink); }
  .projects a :global(.photo) { transition: filter 0.2s ease-out; }
  .projects a:hover :global(.photo) { filter: brightness(0.95); }
  .p-body { display: grid; gap: 0.15rem; }
  .p-title { font-weight: 700; font-size: var(--step-1); letter-spacing: -0.01em; }
  .projects a:hover .p-title { color: var(--green); text-decoration: underline; text-underline-offset: 0.2em; text-decoration-thickness: 2px; }
  .p-eq { color: var(--ink-3); font-size: 0.95rem; }

  .steps { list-style: none; padding: 0; margin: 0 0 2.5rem; display: grid; grid-template-columns: repeat(4, 1fr); gap: 2rem; }
  .steps li { position: relative; }
  .steps li:not(:last-child)::after { content: ''; position: absolute; top: 1.125rem; left: 3rem; right: -1.25rem; height: 1px; background: var(--line-2); }
  .n { position: relative; display: grid; place-items: center; width: 2.25rem; height: 2.25rem; border-radius: 50%; background: var(--green); color: #fff; font-weight: 700; margin-bottom: 1rem; font-variant-numeric: tabular-nums; }
  .steps h3 { margin-bottom: 0.4rem; }
  .steps p { color: var(--ink-2); margin: 0; font-size: 0.97rem; }

  .person { display: grid; grid-template-columns: minmax(0, 0.8fr) minmax(0, 1fr); gap: clamp(2rem, 1rem + 4vw, 5rem); align-items: center; }
  .person > :global(.photo) { border-radius: var(--r); }
  .levels { margin: 1.75rem 0; display: grid; gap: 0; border-top: 1px solid var(--line); }
  .levels > div { display: grid; grid-template-columns: 9rem 1fr; gap: 1rem; padding: 0.9rem 0; border-bottom: 1px solid var(--line); }
  .levels dt { font-weight: 700; display: flex; align-items: center; gap: 0.4rem; }
  .levels dd { margin: 0; color: var(--ink-2); }
  .levels .must dt { color: var(--amber-ink); }
  .sign { margin: 0; line-height: 1.4; }
  .more-work { margin: 1rem 0 0; font-weight: 600; }

  .local-grid { display: grid; grid-template-columns: 1fr 0.85fr; gap: clamp(2rem, 1rem + 4vw, 5rem); align-items: center; }
  .local h2 { font-size: var(--step-4); }
  .local-lead { font-size: var(--step-1); color: var(--on-green-2); line-height: 1.55; max-width: 32rem; }
  .kommuner { list-style: none; padding: 0; margin: 1.75rem 0; display: grid; grid-template-columns: repeat(2, minmax(0, 14rem)); gap: 0.6rem 1.5rem; }
  .kommuner li { display: flex; gap: 0.5rem; align-items: center; font-weight: 600; font-size: 1.05rem; color: #fff; }
  .kommuner :global(svg) { color: #9fd0b2; }
  .local-note { color: var(--on-green-2); margin: 0; }
  .local :global(.local-map) { --map-land: #1f7d48; --map-edge: var(--green); --map-hover: #2b8e56; --map-dot: #fff; --map-text: #fff; --map-halo: var(--green); --map-caption: var(--on-green-2); max-width: 26rem; justify-self: center; width: 100%; }
  .local :global(.local-map .towns circle:not(.ring)) { stroke: var(--green); }
  .local :global(.local-map .towns .ring) { stroke: #fff; }

  .offer { display: grid; grid-template-columns: 1fr 1fr; gap: 1.25rem; }
  .offer-col { border: 1px solid var(--line); border-radius: 12px; padding: 1.75rem; background: #fff; }
  .offer-col--base { border: 2px solid var(--green); }
  .offer-col h3 { font-size: var(--step-2); margin-bottom: 1rem; }
  .offer-col ul { list-style: none; padding: 0; margin: 0; display: grid; gap: 0.7rem; }
  .offer-col li { display: flex; gap: 0.6rem; align-items: flex-start; line-height: 1.45; }
  .offer-col li :global(svg) { color: var(--green); flex: none; margin-top: 0.12rem; }

  .guides { list-style: none; padding: 0; margin: 0; display: grid; grid-template-columns: repeat(4, 1fr); gap: 1.25rem; }
  .guides a { display: flex; flex-direction: column; gap: 0.5rem; height: 100%; padding: 1.4rem; background: #fff; border: 1px solid var(--line); border-radius: 12px; text-decoration: none; color: var(--ink); transition: border-color 0.15s ease-out, background-color 0.15s ease-out; }
  .guides a:hover { border-color: var(--green); background: var(--green-tint); }
  .g-title { font-weight: 700; font-size: 1.1rem; line-height: 1.3; letter-spacing: -0.01em; }
  .g-sum { color: var(--ink-2); font-size: 0.93rem; line-height: 1.5; flex: 1; }
  .g-meta { font-size: var(--step--1); color: var(--green); font-weight: 600; }
  .tool { display: flex; gap: 0.6rem; align-items: center; flex-wrap: wrap; margin: 2rem 0 0; color: var(--ink-2); }
  .tool :global(svg) { color: var(--green); }

  @media (max-width: 1080px) {
    .assure-row { grid-template-columns: repeat(2, 1fr); }
    .assure li:nth-child(3) { border-left: 0; padding-left: 0; }
    .assure li:nth-child(n + 3) { border-top: 1px solid var(--line); }
    .guides { grid-template-columns: repeat(2, 1fr); }
    .steps { grid-template-columns: repeat(2, 1fr); }
    .steps li::after { display: none; }
  }
  @media (max-width: 900px) {
    .hero-grid, .person, .local-grid { grid-template-columns: 1fr; }
    .hero-grid { gap: 1.25rem; }
    .hero-text { display: contents; }
    .hero h1 { order: 1; margin-bottom: 0; }
    .hero .lead { order: 2; margin-bottom: 0; font-size: 1.08rem; }
    .hero-media { order: 3; padding-bottom: 0; display: flex; flex-direction: column-reverse; gap: 1.25rem; }
    .promises { order: 4; margin: 0.5rem 0 0; }
    .call { order: 5; }
    :global(.hero-starter) { position: static; width: auto; margin: 0; }
    .hero-media :global(.hero-photo) { aspect-ratio: 16 / 10 !important; }
    .hero-media :global(.hero-photo.photo--empty) { place-content: center; justify-items: center; text-align: center; }
    .offer { grid-template-columns: 1fr; }
    .projects { grid-template-columns: repeat(2, 1fr); }
    .projects li, .projects li.wide, .projects li:nth-child(n + 6) { grid-column: span 1; }
    .person > :global(.photo) { max-width: 24rem; }
    .local :global(.local-map) { max-width: 20rem; }
  }
  @media (max-width: 560px) {
    .assure-row { grid-template-columns: 1fr; }
    .assure li { border-left: 0 !important; padding-left: 0; }
    .assure li + li { border-top: 1px solid var(--line); }
    .head--row { flex-direction: column; align-items: flex-start; gap: 1rem; }
    .projects, .guides, .steps { grid-template-columns: 1fr; }
    .levels > div { grid-template-columns: 1fr; gap: 0.2rem; }
    .kommuner { grid-template-columns: 1fr 1fr; }
  }
</style>
