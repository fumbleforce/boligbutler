---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import ProjectIcon from '../components/ProjectIcon.astro';
import Faq from '../components/Faq.astro';
import CtaBand from '../components/CtaBand.astro';
import { site, packages, beforeStart } from '../data/site';

const projects = (await getCollection('prosjekter')).sort((a, b) => a.data.order - b.data.order);
const guides = (await getCollection('guider')).sort((a, b) => b.data.updated.valueOf() - a.data.updated.valueOf());
const featuredSlugs = ['drenering-rundt-huset', 'bygge-terrasse', 'leie-minigraver', 'tilhenger-forerkort', 'legge-ny-plen', 'terrasse-soknadsplikt'];
const featured = featuredSlugs.map((s) => guides.find((g) => g.id === s)).filter((g) => g !== undefined);
const shown = featured.length >= 4 ? featured : guides.slice(0, 6);

const faq = [
  { q: 'Hva er forskjellen på BoligButler og et vanlig maskinutleie?', a: 'BoligButler tar utgangspunkt i prosjektet ditt, ikke i maskinen. Du får utstyret levert, en innføring på stedet, en prosjektkasse med det som pleier å mangle, og en rådgiver du kan ringe eller få på befaring.' },
  { q: 'Må jeg kjøpe rådgivning for å leie utstyr?', a: 'Nei. Kunden bestemmer. Råd gir BoligButler når du spør. Instruksjon i trygg bruk av utstyret får du alltid, fordi det handler om sikkerheten din.' },
  { q: 'Hvilke områder dekker BoligButler?', a: 'Horten, Holmestrand, Tønsberg og Re. Ta kontakt hvis du bor like utenfor, så finner dere en løsning.' },
  { q: 'Kan BoligButler gjøre deler av jobben?', a: 'Ja, i Pluss-oppsettet kan BoligButler bistå praktisk i de kritiske fasene, for eksempel utsetting av fall og høyder, eller graving der det er tryggere at en erfaren kjører maskinen.' },
];

const jsonLd = [
  { '@context': 'https://schema.org', '@type': 'WebSite', name: site.name, url: site.url, inLanguage: 'nb-NO' },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faq.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
  },
];
---
<Base
  title="BoligButler – utstyr og rådgiver for deg som gjør prosjektet selv"
  description={site.description}
  jsonLd={jsonLd}
>
  <section class="hero">
    <div class="wrap hero-grid">
      <div class="hero-text">
        <p class="label label--signal">Horten · Holmestrand · Tønsberg · Re</p>
        <h1>Prosjektet er ditt. BoligButler sørger for at det&nbsp;går.</h1>
        <p class="lead">
          Drenering, terrasse, ny plen eller maling av huset. Du gjør jobben, BoligButler stiller med utstyret, leverer det hjem og har en erfaren rådgiver tilgjengelig når du trenger en.
        </p>
        <div class="hero-actions">
          <a class="btn" href="#prosjekter">Velg prosjekt <span class="arrow" aria-hidden="true">↓</span></a>
          <a class="btn btn--ghost" href="/slik-fungerer-det/">Slik fungerer det</a>
        </div>
      </div>

      <figure class="card" aria-label="Utdrag fra sjekklisten som følger med hvert prosjekt">
        <div class="card-head">
          <span class="label">Følger med prosjektkassen</span>
          <span class="hole" aria-hidden="true"></span>
        </div>
        <p class="card-title">Før du starter</p>
        <ul>
          {beforeStart.map((item) => (
            <li><span class="box" aria-hidden="true"></span>{item}</li>
          ))}
        </ul>
        <figcaption>Et laminert ark. Det viktigste i kassen er ikke verktøy.</figcaption>
      </figure>
    </div>
  </section>

  <section id="prosjekter" class="section">
    <div class="wrap">
      <div class="section-head">
        <p class="label">Hva skal du gjøre?</p>
        <h2>Start med prosjektet, ikke med maskinen.</h2>
        <p>Velg hva du skal få til. Så ser du hvilket utstyr som brukes, hva som følger med, og hva BoligButler kan hjelpe med.</p>
      </div>
      <ol class="projects">
        {projects.map((p, i) => (
          <li>
            <a href={`/prosjekter/${p.id}/`}>
              <span class="num">{String(i + 1).padStart(2, '0')}</span>
              <ProjectIcon slug={p.id} size={44} class="icon" />
              <span class="p-main">
                <span class="say">«{p.data.customerSays}»</span>
                <span class="p-title">{p.data.navTitle}</span>
              </span>
              <span class="p-eq">{p.data.equipment.slice(0, 3).map((e) => e.name).join(', ')}</span>
              <span class="go" aria-hidden="true">→</span>
            </a>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section class="section section--forest">
    <div class="wrap">
      <div class="section-head">
        <p class="label">Butleren</p>
        <h2>Hjelp når du vil ha den. Instruksjon når det gjelder sikkerheten.</h2>
        <p>Det er du som bestemmer hvordan prosjektet skal gjøres. BoligButler blander seg ikke inn uoppfordret, men sier tydelig ifra når noe kan skade deg, huset eller utstyret.</p>
      </div>
      <div class="levels">
        <div class="level">
          <span class="lvl-n">Råd</span>
          <p class="lvl-when">Når du spør</p>
          <p>Fundamenttype, hvilken pukk, når på året du bør så. Du får BoligButlers vurdering, og du velger.</p>
        </div>
        <div class="level">
          <span class="lvl-n">Veiledning</span>
          <p class="lvl-when">Når det er naturlig</p>
          <p>Ved levering og befaring viser BoligButler hvordan erfarne folk løser akkurat denne delen av jobben.</p>
        </div>
        <div class="level level--must">
          <span class="lvl-n">Instruksjon</span>
          <p class="lvl-when">Alltid, når det trengs</p>
          <p>Grøftekant, forankring av stillas, svingradius på maskin. Her er det ikke valgfritt, fordi det handler om skader på folk og eiendom.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <div class="section-head">
        <p class="label">Tre oppsett</p>
        <h2>Like mye hjelp som du trenger. Ikke mer.</h2>
        <p>Alle oppsett inkluderer levering og prosjektkasse. Prisen avhenger av prosjektet og utstyret, og du får den før du bestemmer deg.</p>
      </div>
      <div class="pkgs">
        {packages.map((p) => (
          <div class:list={['pkg', { 'pkg--featured': p.featured }]}>
            <h3>{p.name}</h3>
            <p class="pkg-for">{p.for}</p>
            <ul>{p.items.map((i) => <li>{i}</li>)}</ul>
          </div>
        ))}
      </div>
      <p class="more"><a href="/slik-fungerer-det/">Les hvordan et prosjekt med BoligButler foregår</a></p>
    </div>
  </section>

  <section class="section section--paper2">
    <div class="wrap">
      <div class="section-head">
        <p class="label">Guider</p>
        <h2>Lær deg jobben før du leier noe.</h2>
        <p>Fremgangsmåter, mål og vanlige feil, skrevet for deg som skal gjøre det selv. Gratis å lese, enten du leier av BoligButler eller ikke.</p>
      </div>
      <ul class="guides">
        {shown.map((g) => (
          <li>
            <a href={`/guider/${g.id}/`}>
              <span class="label">{g.data.difficulty}</span>
              <span class="g-title">{g.data.title}</span>
              <span class="g-sum">{g.data.description}</span>
            </a>
          </li>
        ))}
      </ul>
      <p class="more"><a href="/guider/">Alle guider</a> · <a href="/verktoy/massekalkulator/">Beregn masser</a></p>
    </div>
  </section>

  <section class="section">
    <div class="narrow">
      <Faq items={faq} />
    </div>
  </section>

  <CtaBand />
</Base>

<style>
  .hero { padding-block: clamp(2.5rem, 2rem + 4vw, 6rem) clamp(3rem, 2rem + 4vw, 6rem); border-bottom: 1px solid var(--line); position: relative; isolation: isolate; }
  .hero::before { content: ''; position: absolute; inset: 0; z-index: -1;
    background-image: linear-gradient(var(--line) 1px, transparent 1px), linear-gradient(90deg, var(--line) 1px, transparent 1px);
    background-size: 32px 32px; background-position: -1px -1px;
    -webkit-mask-image: linear-gradient(100deg, transparent 35%, #000 70%); mask-image: linear-gradient(100deg, transparent 35%, #000 70%); }
  .hero-grid { display: grid; grid-template-columns: 1.35fr 1fr; gap: clamp(2rem, 1rem + 4vw, 5rem); align-items: center; }
  .hero h1 { margin-top: 0.6rem; max-width: 13em; }
  .hero-actions { display: flex; flex-wrap: wrap; gap: 0.75rem; margin-top: 2rem; }

  .card { margin: 0; background: #fffdf7; border: 1px solid var(--line); border-radius: 10px; padding: 1.5rem 1.6rem 1.2rem;
    box-shadow: 0 1px 0 #fff inset, 0 24px 40px -24px rgb(28 33 30 / 0.35), 0 2px 6px -2px rgb(28 33 30 / 0.12);
    transform: rotate(1.2deg); max-width: 24rem; justify-self: end; position: relative; }
  .card::before { content: ''; position: absolute; inset: 6px; border-radius: 6px; border: 1px solid rgb(0 0 0 / 0.04); pointer-events: none; }
  .card-head { display: flex; justify-content: space-between; align-items: center; }
  .hole { width: 14px; height: 14px; border-radius: 50%; background: var(--paper); box-shadow: inset 0 1px 2px rgb(0 0 0 / 0.25); }
  .card-title { font-family: var(--serif); font-size: var(--step-2); margin: 0.6rem 0 0.8rem; }
  .card ul { list-style: none; margin: 0; padding: 0; }
  .card li { display: flex; gap: 0.7rem; align-items: baseline; padding: 0.42rem 0; border-bottom: 1px dashed var(--line); }
  .box { flex: none; width: 13px; height: 13px; border: 1.5px solid var(--ink); border-radius: 2px; position: relative; top: 2px; }
  .card li:nth-child(1) .box, .card li:nth-child(2) .box { background: linear-gradient(45deg, transparent 45%, var(--signal) 45% 60%, transparent 60%), linear-gradient(-45deg, transparent 45%, var(--signal) 45% 60%, transparent 60%); }
  .card figcaption { font-family: var(--serif); font-style: italic; color: var(--ink-3); font-size: 0.95rem; margin-top: 1rem; }

  .projects { list-style: none; margin: 0; padding: 0; border-top: 1.5px solid var(--ink); }
  .projects a { display: grid; grid-template-columns: 2.5rem 44px 1.3fr 1fr 1.5rem; gap: 1.25rem; align-items: center; padding: 1.3rem 0.25rem; border-bottom: 1px solid var(--line); text-decoration: none; transition: background 0.15s, padding 0.15s; }
  .projects a:hover { background: var(--card); padding-inline: 1rem; color: var(--ink); }
  .num { font-variant-numeric: tabular-nums; color: var(--ink-3); font-size: var(--step--1); }
  .projects :global(.icon) { color: var(--ink); }
  .p-main { display: grid; }
  .say { font-family: var(--serif); font-style: italic; color: var(--ink-3); font-size: 0.98rem; }
  .p-title { font-family: var(--serif); font-size: var(--step-2); line-height: 1.15; }
  .p-eq { color: var(--ink-2); font-size: 0.95rem; }
  .go { font-size: 1.3rem; transition: transform 0.15s; }
  .projects a:hover .go { transform: translateX(4px); color: var(--signal); }

  .levels { display: grid; grid-template-columns: repeat(3, 1fr); border-top: 1px solid rgb(234 230 219 / 0.35); }
  .level { padding: 1.75rem 1.75rem 0.5rem 0; }
  .level + .level { padding-left: 1.75rem; border-left: 1px solid rgb(234 230 219 / 0.2); }
  .lvl-n { font-family: var(--serif); font-size: var(--step-3); display: block; line-height: 1; }
  .lvl-when { font-size: var(--step--1); letter-spacing: 0.08em; text-transform: uppercase; color: #b9c2b4; margin: 0.6rem 0 1rem; font-weight: 600; }
  .level p:last-child { color: #d7dbd0; }
  .level--must .lvl-n { color: #f08a5d; }
  .level--must { position: relative; }
  .level--must::before { content: ''; position: absolute; top: -1px; left: 1.75rem; right: 0; height: 3px; background: var(--signal); }

  .pkgs { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1rem; }
  .pkg { border: 1px solid var(--line); background: var(--card); padding: 1.6rem; border-radius: var(--radius); }
  .pkg--featured { border-color: var(--ink); box-shadow: 4px 4px 0 var(--ink); }
  .pkg h3 { font-family: var(--serif); font-size: var(--step-2); font-weight: 500; margin-bottom: 0.3em; }
  .pkg-for { color: var(--ink-2); min-height: 3.2em; }
  .pkg ul { list-style: none; padding: 0; margin: 1rem 0 0; border-top: 1px solid var(--line); }
  .pkg li { padding: 0.55rem 0 0.55rem 1.4rem; border-bottom: 1px solid var(--line); position: relative; font-size: 0.97rem; }
  .pkg li::before { content: ''; position: absolute; left: 0.1rem; top: 1.05rem; width: 8px; height: 1.5px; background: var(--signal); }
  .more { margin-top: 2rem; }

  .guides { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(3, 1fr); gap: 0 2rem; }
  .guides a { display: grid; gap: 0.4rem; padding: 1.4rem 0; border-top: 1px solid var(--ink); text-decoration: none; height: 100%; align-content: start; }
  .g-title { font-family: var(--serif); font-size: var(--step-1); line-height: 1.25; }
  .guides a:hover .g-title { text-decoration: underline; text-decoration-color: var(--signal); }
  .g-sum { color: var(--ink-2); font-size: 0.95rem; }

  @media (max-width: 900px) {
    .hero::before { -webkit-mask-image: linear-gradient(180deg, transparent 45%, #000 85%); mask-image: linear-gradient(180deg, transparent 45%, #000 85%); }
    .hero-grid { grid-template-columns: 1fr; }
    .card { justify-self: start; transform: rotate(0.6deg); }
    .levels, .pkgs, .guides { grid-template-columns: 1fr; }
    .level + .level { padding-left: 0; border-left: 0; border-top: 1px solid rgb(234 230 219 / 0.2); }
    .level--must::before { left: 0; }
    .pkg-for { min-height: 0; }
  }
  @media (max-width: 640px) {
    .projects a { grid-template-columns: 36px 1fr 1.2rem; gap: 0.9rem; }
    .num, .p-eq { display: none; }
  }
</style>
