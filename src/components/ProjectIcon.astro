---
// Strektegninger i «arbeidstegning»-stil, én per prosjekt.
interface Props { slug: string; size?: number; class?: string }
const { slug, size = 48, class: cls } = Astro.props;
---
<svg
  class={cls}
  width={size}
  height={size}
  viewBox="0 0 48 48"
  fill="none"
  stroke="currentColor"
  stroke-width="1.5"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
>
  {slug === 'drenering' && (
    <>
      <path d="M4 14h14M30 14h14" />
      <path d="M18 6v34h-4" />
      <path d="M18 14l12 0" stroke-dasharray="2 3" />
      <circle cx="25" cy="35" r="4" />
      <path d="M22 26c3 1 6 1 9 0M20 20c4 1 8 1 12 0" stroke-dasharray="1 3" />
      <path d="M33 38l8 2" class="accent" />
    </>
  )}
  {slug === 'terrasse' && (
    <>
      <path d="M4 22h40M4 26h40" />
      <path d="M10 26v14M24 26v14M38 26v14" />
      <path d="M7 40h6M21 40h6M35 40h6" />
      <path d="M8 18h4M16 18h4M24 18h4M32 18h4" class="accent" />
    </>
  )}
  {slug === 'plen' && (
    <>
      <path d="M4 32h40" />
      <path d="M4 38h40" stroke-dasharray="1 3" />
      <path d="M9 32c0-5 1-9 3-12M12 32c0-4-1-7-3-9M20 32c0-6 2-11 5-14M23 32c0-4-1-8-3-10M31 32c0-5 1-8 4-11M35 32c0-3-1-6-3-8" />
      <path d="M40 22v-6M37 19h6" class="accent" />
    </>
  )}
  {slug === 'male-huset' && (
    <>
      <path d="M6 22L22 9l16 13" />
      <path d="M10 19v21h24V19" />
      <path d="M18 40v-9h8v9" />
      <path d="M14 23h4v4h-4zM26 23h4v4h-4z" />
      <path d="M37 30h7v5h-7zM40.5 35v6" class="accent" />
    </>
  )}
  {slug === 'stottemur' && (
    <>
      <path d="M6 40h36" />
      <path d="M8 40V18h12v22" />
      <path d="M8 25.5h12M8 33h12M14 18v7.5M11 25.5V33M17 25.5V33M14 33v7" />
      <path d="M20 18c6 0 12-2 22-8" />
      <path d="M24 26l4 10M30 22l4 12" stroke-dasharray="1 3" class="accent" />
    </>
  )}
  {slug === 'gravearbeid' && (
    <>
      <path d="M4 40h40" />
      <rect x="6" y="28" width="18" height="8" rx="2" />
      <path d="M10 28v-8h8l2 8" />
      <path d="M20 24l10-12 8 6" />
      <path d="M38 18l2 7-6 1" class="accent" />
      <circle cx="11" cy="36" r="2" /><circle cx="19" cy="36" r="2" />
    </>
  )}
  {slug === 'traer' && (
    <>
      <path d="M24 42V20" />
      <path d="M24 30l-7-6M24 25l7-6M24 34l6-4" />
      <path d="M24 8c-8 0-13 5-13 11 0 4 3 6 6 6M24 8c8 0 13 5 13 11 0 4-3 6-6 6" />
      <path d="M14 42h20" />
      <path d="M33 17l5-3" class="accent" />
    </>
  )}
</svg>
<style>
  svg :global(.accent) { stroke: var(--signal); }
</style>
