---
// Fotoplass. Legg et ekte bilde i public/bilder/<name>.jpg (eller .webp), så brukes det automatisk.
// Uten fil vises en tydelig merket plassholder, slik at ingen tror et illustrasjonsbilde er ekte.
import fs from 'node:fs';
import path from 'node:path';

interface Props { name: string; alt: string; hint: string; ratio?: string; class?: string; eager?: boolean; fit?: 'cover' | 'contain'; position?: string }
const { name, alt, hint, ratio = '4 / 3', class: cls, eager = false, fit = 'cover', position = 'center' } = Astro.props;

const dir = path.join(process.cwd(), 'public', 'bilder');
const file = ['webp', 'jpg', 'jpeg', 'png'].map((e) => `${name}.${e}`).find((f) => fs.existsSync(path.join(dir, f)));
---
{file ? (
  <img class:list={['photo', { 'photo--contain': fit === 'contain' }, cls]} src={`/bilder/${file}`} alt={alt} style={`aspect-ratio:${ratio};object-position:${position}`} loading={eager ? 'eager' : 'lazy'} decoding="async" />
) : (
  <div class:list={['photo', 'photo--empty', cls]} style={`aspect-ratio:${ratio}`} role="img" aria-label={alt}>
    <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3.5 7.5h4l1.5-2h6l1.5 2h4v11h-17z" /><circle cx="12" cy="13" r="3.5" /></svg>
    <span>Foto: {hint}</span>
    <code>public/bilder/{name}.jpg</code>
  </div>
)}
<style>
  .photo { width: 100%; height: auto; object-fit: cover; border-radius: var(--r); background: var(--band); }
  .photo--contain { object-fit: contain; background: #fff; border: 1px solid var(--line); padding: 4%; }
  .photo--empty {
    display: grid; place-content: center; justify-items: center; gap: 0.5rem; padding: 1.5rem; text-align: center;
    color: var(--ink-3); font-size: var(--step--1); line-height: 1.4;
    background: linear-gradient(160deg, #eef2ef, #e0e8e3);
  }
  .photo--empty span { max-width: 22rem; color: var(--ink-2); font-weight: 500; }
  .photo--empty code { font-size: 0.75rem; opacity: 0.8; }
</style>
