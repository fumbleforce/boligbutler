---
import { getCollection } from 'astro:content';
import Wordmark from './Wordmark.astro';
import Icon from './Icon.astro';
import { site } from '../data/site';

const projects = (await getCollection('prosjekter')).sort((a, b) => a.data.order - b.data.order);
const path = Astro.url.pathname;
const tel = `tel:${site.phone.replace(/\s/g, '')}`;
const main = [
  { href: '/prosjekter/', label: 'Prosjekter' },
  { href: '/slik-fungerer-det/', label: 'Slik fungerer det' },
  { href: '/guider/', label: 'Guider' },
  { href: '/utstyr/', label: 'Utstyr' },
  { href: '/om/', label: 'Om BoligButler' },
];
---
<div class="strip">
  <div class="wrap strip-row">
    <p><Icon name="pin" size={16} /> Tilgjengelig i hele Vestfold</p>
    <a href={tel}><Icon name="phone" size={16} /> {site.phoneDisplay}</a>
  </div>
</div>
<header class="hdr">
  <div class="wrap top">
    <a href="/" class="home" aria-label="BoligButler, til forsiden"><Wordmark /></a>
    <nav aria-label="Hovedmeny" class="main">
      <ul>
        {main.map((l) => (
          <li><a href={l.href} aria-current={path.startsWith(l.href) ? 'page' : undefined}>{l.label}</a></li>
        ))}
      </ul>
    </nav>
    <a class="btn btn--ghost phone-btn" href={tel}><Icon name="phone" size={18} /> <span>{site.phoneDisplay}</span></a>
    <a class="btn cta" href="/kontakt/">Start et prosjekt</a>
    <details class="mobile">
      <summary aria-label="Åpne meny"><span></span><span></span><span></span></summary>
      <nav aria-label="Mobilmeny">
        <ul>
          {main.map((l) => <li><a href={l.href}>{l.label}</a></li>)}
          <li><a href="/kontakt/">Kontakt</a></li>
        </ul>
        <p class="m-label">Prosjekter</p>
        <ul class="m-projects">
          {projects.map((p) => <li><a href={`/prosjekter/${p.id}/`}>{p.data.navTitle}</a></li>)}
        </ul>
        <a class="btn m-cta" href={tel}><Icon name="phone" size={18} /> Ring {site.phoneDisplay}</a>
      </nav>
    </details>
  </div>
  <nav class="projects" aria-label="Prosjekter">
    <div class="wrap">
      <ul class="row">
        {projects.map((p) => (
          <li><a href={`/prosjekter/${p.id}/`} aria-current={path.startsWith(`/prosjekter/${p.id}/`) ? 'page' : undefined}>{p.data.navTitle}</a></li>
        ))}
      </ul>
    </div>
  </nav>
</header>

<style>
  .strip { background: var(--green); color: var(--on-green); font-size: var(--step--1); }
  .strip-row { display: flex; justify-content: space-between; align-items: center; gap: 1rem; min-height: 2.4rem; }
  .strip p { margin: 0; display: flex; align-items: center; gap: 0.45rem; }
  .strip a { color: #fff; text-decoration: none; font-weight: 600; display: inline-flex; align-items: center; gap: 0.4rem; white-space: nowrap; font-variant-numeric: tabular-nums; }
  .strip a:hover { text-decoration: underline; }

  .hdr { background: #fff; border-bottom: 1px solid var(--line); position: relative; z-index: 10; }
  .top { display: flex; align-items: center; gap: 2rem; min-height: 4.5rem; }
  .home { text-decoration: none; margin-right: auto; }
  ul { list-style: none; margin: 0; padding: 0; }
  .main ul { display: flex; gap: 1.6rem; }
  .main a { color: var(--ink); text-decoration: none; font-weight: 550; font-size: 0.98rem; padding-block: 0.4rem; }
  .main a:hover, .main a[aria-current] { color: var(--green); box-shadow: inset 0 -2px 0 var(--green); }
  .cta, .phone-btn { min-height: 2.75rem; padding: 0.6em 1.1em; font-size: 0.95rem; }
  .top .cta { margin-left: -1.25rem; }
  .phone-btn { font-variant-numeric: tabular-nums; }

  .projects { border-top: 1px solid var(--line); }
  .row { display: flex; gap: 1.6rem; overflow-x: auto; scrollbar-width: none; }
  .row::-webkit-scrollbar { display: none; }
  .projects a { display: block; white-space: nowrap; padding: 0.7rem 0; color: var(--ink-2); text-decoration: none; font-size: 0.93rem; font-weight: 500; }
  .projects a:hover, .projects a[aria-current] { color: var(--green); box-shadow: inset 0 -2px 0 var(--green); }

  .mobile { display: none; position: relative; }
  .mobile summary { list-style: none; cursor: pointer; width: 2.75rem; height: 2.75rem; display: grid; place-content: center; gap: 5px; border: 1px solid var(--line); border-radius: var(--r); }
  .mobile summary::-webkit-details-marker { display: none; }
  .mobile summary span { display: block; width: 20px; height: 2px; background: var(--ink); border-radius: 1px; }
  .mobile nav { position: absolute; right: 0; top: calc(100% + 0.6rem); background: #fff; border: 0; border-radius: var(--r); width: min(20rem, calc(100vw - 2rem)); padding: 0.5rem; box-shadow: var(--shadow-lg); }
  .mobile a:not(.btn) { display: block; padding: 0.65rem 0.8rem; color: var(--ink); text-decoration: none; border-radius: 6px; font-weight: 550; }
  .mobile a:not(.btn):hover { background: var(--band); }
  .m-label { margin: 0.6rem 0.8rem 0.2rem; font-size: var(--step--1); color: var(--ink-3); }
  .m-projects { display: grid; grid-template-columns: 1fr 1fr; }
  .m-projects a { font-weight: 450 !important; font-size: 0.95rem; }
  .m-cta { width: 100%; margin-top: 0.5rem; }

  @media (max-width: 1000px) {
    .main { display: none; }
    .mobile { display: block; }
  }
  @media (max-width: 1180px) and (min-width: 1001px) { .phone-btn span { display: none; } }
  @media (max-width: 640px) {
    .top { gap: 0.6rem; }
    .phone-btn { padding: 0; width: 2.75rem; }
    .phone-btn span { display: none; }
    .strip p { font-size: 0.8rem; }
    .cta { display: none; }
    .projects { display: none; }
  }

</style>
