---
import { getCollection } from 'astro:content';
import Wordmark from './Wordmark.astro';
import Icon from './Icon.astro';
import { site } from '../data/site';

const projects = (await getCollection('prosjekter')).sort((a, b) => a.data.order - b.data.order);
const year = new Date().getFullYear();
const tel = `tel:${site.phone.replace(/\s/g, '')}`;
---
<footer class="ftr">
  <div class="wrap grid">
    <div class="about">
      <Wordmark inverse />
      <p>{site.vision}</p>
      <p class="area">Levering og veiledning i hele Vestfold: {site.areas.join(', ')}.</p>
    </div>
    <nav aria-label="Prosjekter i bunnteksten">
      <h2>Prosjekter</h2>
      <ul>{projects.map((p) => <li><a href={`/prosjekter/${p.id}/`}>{p.data.navTitle}</a></li>)}</ul>
    </nav>
    <nav aria-label="Om BoligButler">
      <h2>BoligButler</h2>
      <ul>
        <li><a href="/slik-fungerer-det/">Slik fungerer det</a></li>
        <li><a href="/guider/">Guider</a></li>
        <li><a href="/verktoy/massekalkulator/">Massekalkulator</a></li>
        <li><a href="/utstyr/">Utstyr</a></li>
        <li><a href="/om/">Om BoligButler</a></li>
      </ul>
    </nav>
    <div>
      <h2>Kontakt</h2>
      <ul class="contact">
        <li><a href={tel}><Icon name="phone" size={18} /> {site.phoneDisplay}</a></li>
        <li><a href={`mailto:${site.email}`}><Icon name="mail" size={18} /> {site.email}</a></li>
        <li class="addr"><Icon name="pin" size={18} /> <span>{site.address.street}<br />{site.address.postalCode} {site.address.city}</span></li>
        <li><a href="/kontakt/"><Icon name="chat" size={18} /> Beskriv prosjektet ditt</a></li>
      </ul>
    </div>
  </div>
  <div class="wrap legal">
    <p>© {year} {site.legalName}, {site.address.street}, {site.address.postalCode} {site.address.city}. Org.nr. {site.orgnr}.</p>
    <p>Kartdata © Kartverket</p>
  </div>
</footer>
<style>
  .ftr { background: var(--green-2); color: var(--on-green-2); padding-top: clamp(3rem, 2rem + 3vw, 4.5rem); }
  .grid { display: grid; grid-template-columns: 1.5fr 1fr 1fr 1.2fr; gap: 2.5rem; }
  .about p { max-width: 24rem; margin-top: 1rem; }
  .area { color: #fff; }
  h2 { font-size: 0.95rem; color: #fff; letter-spacing: 0; margin-bottom: 0.9rem; }
  ul { list-style: none; padding: 0; margin: 0; display: grid; gap: 0.5rem; }
  a { color: var(--on-green-2); text-decoration: none; }
  a:hover { color: #fff; text-decoration: underline; }
  .contact a, .addr { display: inline-flex; gap: 0.5rem; align-items: center; color: #fff; }
  .addr { align-items: flex-start; line-height: 1.45; }
  .addr :global(svg) { margin-top: 0.15rem; }
  .legal { display: flex; flex-wrap: wrap; justify-content: space-between; gap: 0.5rem 2rem; margin-top: 3rem; padding-block: 1.25rem 1.5rem; border-top: 1px solid rgb(255 255 255 / 0.15); font-size: var(--step--1); }
  .legal p { margin: 0; }
  @media (max-width: 820px) { .grid { grid-template-columns: 1fr 1fr; } .about { grid-column: 1 / -1; } }
</style>
