---
// Egentegnet ikonsett: 24px rutenett, 1.75 strek, avrundede ender.
interface Props { name: 'arrow' | 'phone' | 'truck' | 'person' | 'kit' | 'check' | 'warning' | 'pin' | 'mail' | 'price' | 'chat' | 'list'; size?: number; class?: string }
const { name, size = 20, class: cls } = Astro.props;
---
<svg class={cls} width={size} height={size} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
  {name === 'arrow' && <path d="M5 12h14M13 6l6 6-6 6" />}
  {name === 'phone' && <path d="M5 4h3.5l1.8 4.5-2.3 1.4a11 11 0 0 0 6.1 6.1l1.4-2.3L20 15.5V19a1.5 1.5 0 0 1-1.6 1.5A16.5 16.5 0 0 1 3.5 5.6 1.5 1.5 0 0 1 5 4Z" />}
  {name === 'truck' && <><path d="M2.5 6.5h11v9h-11zM13.5 9.5h4l3 3.2v2.8h-7" /><circle cx="6.5" cy="17.5" r="1.8" /><circle cx="17" cy="17.5" r="1.8" /></>}
  {name === 'person' && <><circle cx="12" cy="8" r="3.5" /><path d="M5 20c.8-3.8 3.6-6 7-6s6.2 2.2 7 6" /></>}
  {name === 'kit' && <><path d="M3.5 8.5h17v11h-17z" /><path d="M9 8.5V6a1.5 1.5 0 0 1 1.5-1.5h3A1.5 1.5 0 0 1 15 6v2.5M3.5 13h17M11 13v2h2v-2" /></>}
  {name === 'check' && <path d="m5 12.5 4.5 4.5L19 7.5" />}
  {name === 'warning' && <><path d="M12 3.5 2.5 20h19L12 3.5Z" /><path d="M12 10v4.5" /><circle cx="12" cy="17.3" r=".5" fill="currentColor" /></>}
  {name === 'pin' && <><path d="M12 21s-6.5-6.2-6.5-11.2a6.5 6.5 0 0 1 13 0C18.5 14.8 12 21 12 21Z" /><circle cx="12" cy="10" r="2.3" /></>}
  {name === 'mail' && <><path d="M3.5 5.5h17v13h-17z" /><path d="m4 6.5 8 6.5 8-6.5" /></>}
  {name === 'price' && <><path d="M3.5 12.2V4.5a1 1 0 0 1 1-1h7.7l8.3 8.3-8.7 8.7-8.3-8.3Z" /><circle cx="8" cy="8" r="1.3" /></>}
  {name === 'chat' && <path d="M4 5h16v11H9l-5 4V5Z" />}
  {name === 'list' && <path d="M9 6.5h11M9 12h11M9 17.5h11M4.5 6.5h.01M4.5 12h.01M4.5 17.5h.01" />}
</svg>
