---
// Kart over kommunene i Vestfold. Kartdata: Kartverket (CC BY 4.0), via robhop/fylker-og-kommuner.
import map from '../data/vestfold-kart.json';

interface Props { class?: string; labels?: boolean }
const { class: cls, labels = true } = Astro.props;
// Etikettplassering: noen navn står til venstre for punktet for å ikke kollidere med kysten
const left = new Set(['Holmestrand', 'Sandefjord', 'Larvik']);
---
<figure class:list={['map', cls]}>
  <svg viewBox={`-40 -20 ${map.width + 160} ${map.height + 40}`} role="img" aria-labelledby="kart-tittel">
    <title id="kart-tittel">Kart over Vestfold med kommunene Holmestrand, Horten, Tønsberg, Færder, Sandefjord og Larvik</title>
    <g class="land">
      {map.kommuner.map((k) => <path d={k.d}><title>{k.name}</title></path>)}
    </g>
    {labels && (
      <g class="towns">
        {Object.entries(map.towns).map(([name, [x, y]]) => (
          <g transform={`translate(${x} ${y})`}>
            <circle r="7" />
            <text x={left.has(name) ? -14 : 14} y="6" text-anchor={left.has(name) ? 'end' : 'start'}>{name}</text>
          </g>
        ))}
      </g>
    )}
  </svg>
  <figcaption>Kartdata © Kartverket (CC BY 4.0)</figcaption>
</figure>
<style>
  .map { margin: 0; }
  svg { width: 100%; height: auto; overflow: visible; }
  .land path { fill: var(--map-land, #cfe0d5); stroke: var(--map-edge, #fff); stroke-width: 2.5; stroke-linejoin: round; transition: fill 0.15s ease-out; }
  .land path:hover { fill: var(--map-hover, #b5cfbf); }
  .towns circle { fill: var(--map-dot, var(--green)); stroke: #fff; stroke-width: 3; }
  .towns text { font: 650 36px var(--font); fill: var(--map-text, var(--ink)); paint-order: stroke; stroke: var(--map-halo, #fff); stroke-width: 7px; stroke-linejoin: round; }
  figcaption { font-size: 0.75rem; color: var(--map-caption, var(--ink-3)); margin-top: 0.5rem; }
</style>
