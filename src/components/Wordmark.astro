---
// Logo: emblemet fra BoligButlers logo (public/logo-emblem.png) og navnet satt i profilskriften.
// Den fullstendige logoen ligger i public/logo.png.
interface Props { inverse?: boolean }
const { inverse = false } = Astro.props;
---
<span class:list={['wordmark', { inverse }]}>
  <span class="mark"><img src="/logo-emblem.webp" alt="" width="38" height="46" /></span>
  <span>BoligButler</span>
</span>
<style>
  .wordmark { display: inline-flex; align-items: center; gap: 0.55rem; font-weight: 750; font-size: 1.3rem; letter-spacing: -0.025em; line-height: 1; color: var(--ink); }
  .mark { display: grid; place-items: center; }
  .mark img { width: 38px; height: auto; }
  .inverse { color: #fff; }
  .inverse .mark { background: #fff; border-radius: var(--r); padding: 5px 7px; }
  .inverse .mark img { width: 30px; }
</style>
