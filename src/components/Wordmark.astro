---
// Midlertidig ordmerke. Bytt ut med den faktiske logoen (SVG) når den foreligger.
interface Props { inverse?: boolean }
const { inverse = false } = Astro.props;
---
<span class:list={['wordmark', { inverse }]}>
  <svg width="30" height="30" viewBox="0 0 32 32" aria-hidden="true">
    <rect width="32" height="32" rx="7" class="tile" />
    <path d="M7 16 16 9l9 7" fill="none" class="ln" stroke-width="2.4" stroke-linejoin="round" stroke-linecap="round" />
    <path d="M10 15v9h12v-9" fill="none" class="ln" stroke-width="2.4" stroke-linejoin="round" />
  </svg>
  <span>BoligButler</span>
</span>
<style>
  .wordmark { display: inline-flex; align-items: center; gap: 0.55rem; font-weight: 750; font-size: 1.3rem; letter-spacing: -0.025em; line-height: 1; color: var(--ink); }
  .tile { fill: var(--green); }
  .ln { stroke: #fff; }
  .inverse { color: #fff; }
  .inverse .tile { fill: #fff; }
  .inverse .ln { stroke: var(--green); }
</style>
