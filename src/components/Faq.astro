---
interface Props { items: { q: string; a: string }[]; heading?: string }
const { items, heading = 'Spørsmål og svar' } = Astro.props;
---
{items.length > 0 && (
  <section class="faq" aria-labelledby="faq-h">
    <h2 id="faq-h">{heading}</h2>
    <div class="list">
      {items.map((f) => (
        <details>
          <summary><span>{f.q}</span></summary>
          <p>{f.a}</p>
        </details>
      ))}
    </div>
  </section>
)}
<style>
  .faq h2 { font-size: var(--step-2); }
  .list { border-top: 1px solid var(--line-2); }
  details { border-bottom: 1px solid var(--line); }
  summary { cursor: pointer; list-style: none; padding: 1.15rem 2.5rem 1.15rem 0; font-weight: 600; position: relative; font-size: 1.05rem; }
  summary:hover { color: var(--green); }
  summary::-webkit-details-marker { display: none; }
  summary::after { content: ''; position: absolute; right: 0.4rem; top: 50%; width: 10px; height: 10px; border-right: 2px solid var(--green); border-bottom: 2px solid var(--green); transform: translateY(-70%) rotate(45deg); transition: transform 0.15s; }
  details[open] summary::after { transform: translateY(-30%) rotate(-135deg); }
  details p { margin: 0 0 1.2rem; color: var(--ink-2); max-width: 40rem; }
</style>
