---
import { site } from '../data/site';
interface Props { heading?: string; text?: string }
const {
  heading = 'Fortell BoligButler hva du skal gjøre.',
  text = 'Beskriv prosjektet med noen setninger. Du får et forslag til utstyr og oppsett, og bestemmer selv hvor mye hjelp du vil ha.',
} = Astro.props;
---
<section class="section section--forest cta">
  <div class="wrap inner">
    <div>
      <h2>{heading}</h2>
      <p>{text}</p>
    </div>
    <div class="actions">
      <a class="btn btn--light" href="/kontakt/">Beskriv prosjektet <span class="arrow" aria-hidden="true">→</span></a>
      <a class="phone" href={`tel:${site.phone.replace(/\s/g, '')}`}>eller ring {site.phoneDisplay}</a>
    </div>
  </div>
</section>
<style>
  .inner { display: grid; grid-template-columns: 1.4fr 1fr; gap: 2rem; align-items: end; }
  h2 { margin-bottom: 0.4em; max-width: 18em; }
  p { color: #c9cfc3; max-width: 34rem; margin: 0; font-size: var(--step-1); line-height: 1.5; }
  .actions { display: grid; gap: 1rem; justify-items: start; }
  .phone { color: var(--on-forest); }
  @media (max-width: 760px) { .inner { grid-template-columns: 1fr; } }
</style>
